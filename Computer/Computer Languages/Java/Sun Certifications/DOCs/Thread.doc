<BODY lang=EN-US style="tab-interval: .5in">
<DIV class=Section1>
<P class=MsoNormal style="TEXT-ALIGN: center" align=center>SCJP 5.0 Study 
Notes</P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></B></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt">Collections Framework </SPAN></B><SPAN 
style="FONT-SIZE: 9pt">(only Maps, <SPAN class=SpellE>Iterators</SPAN> do not 
extend <SPAN class=SpellE>java.io.Collection</SPAN> 
Interface)<o:p></o:p></SPAN></P>
<TABLE class=MsoTableGrid 
style="BORDER-RIGHT: medium none; BORDER-TOP: medium none; BORDER-LEFT: medium none; WIDTH: 7.7in; BORDER-BOTTOM: medium none; BORDER-COLLAPSE: collapse; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 480; mso-padding-alt: 0in 5.4pt 0in 5.4pt; mso-border-insideh: .5pt solid windowtext; mso-border-insidev: .5pt solid windowtext" 
cellSpacing=0 cellPadding=0 width=739 border=1>
  <TBODY>
  <TR style="mso-yfti-irow: 0; mso-yfti-firstrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Collection 
      interface<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">add(E)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">addAll</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Collection&lt;e&gt;)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">remove(Object)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN class=GramE><SPAN 
      style="FONT-SIZE: 9pt">removeAll</SPAN></SPAN></SPAN><SPAN 
      class=GramE><SPAN style="FONT-SIZE: 9pt">(</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">Collection&lt;?&gt;)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">contains(Object)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">size()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">iterator</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">isEmpty</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Object[] <SPAN 
      class=SpellE>toArray</SPAN>() – returns Object array, must cast – e.g. 
      String[] <SPAN class=SpellE>str</SPAN> = (String[]) <SPAN 
      class=SpellE>myCollection.toArray</SPAN>();<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">T[] <SPAN 
      class=SpellE>toArry</SPAN>(T[] a) – returns typecast array – syntax: 
      String[] <SPAN class=SpellE>str</SPAN> = <SPAN 
      class=SpellE>myCollection.toArray</SPAN>(new 
      String[0]);<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 1">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Map 
      interface,<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">SortedMap</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> interface extends Map<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">put(<SPAN 
      class=SpellE>keyObject</SPAN>, <SPAN class=SpellE>valueObject</SPAN>) – 
      inserts key/value pair, will <I 
      style="mso-bidi-font-style: normal">overwrite</I> duplicate <SPAN 
      class=SpellE>keyObject</SPAN> values<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">keySet</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt">() 
      – returns set of keys<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">values() – returns 
      collection of values<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">get(Object), 
      remove(Object), size(), clear()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">entrySet</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns set of <SPAN 
      class=SpellE>Map.Entry</SPAN> type (key/value pair)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Map.Entry</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> – a key/value pair, has <SPAN 
      class=SpellE>getKey</SPAN>() and <SPAN class=SpellE>getValue</SPAN>() 
      methods<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Maps care about unique 
      identifiers<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">There is no add() method; 
      Don’t have to override equals(Object) method to compile, but necessary to 
      find objects<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 2">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">HashMap</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 3">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Hashtable</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">synchronized version of 
      <SPAN class=SpellE>HashMap</SPAN><o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 4">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">TreeMap</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Can have null values, but 
      NO null keys<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 5">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">LinkedHashMap</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> (extends <SPAN 
      class=SpellE>Hashmap</SPAN>)<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">maintains insertion order, 
      slower updates, faster iteration than <SPAN class=SpellE>HashMap</SPAN>, 
      order remains same if replacing duplicate key, can have null keys or 
      values<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 6">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Set interface, <SPAN 
      class=SpellE>SortedSet</SPAN> interface extends 
    Set<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">boolean</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
      add() – if element already exists, returns false and element not 
      added<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Sets care about 
      uniqueness<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 7">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">HashSet</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 8">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">LinkedHashSet</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> (extends <SPAN 
      class=SpellE>HashSet</SPAN>)<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">fastest iteration through 
      items without duplicates (a Set) that maintains insertion 
      order<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 9">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">TreeSet</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">&lt;T&gt;<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new <SPAN 
      class=SpellE>TreeSet</SPAN>(), new <SPAN 
      class=SpellE>TreeSet</SPAN>(Collection&lt;E&gt;), new <SPAN 
      class=SpellE>TreeSet</SPAN>&lt;T&gt;(Comparator&lt;? super 
      E&gt;)<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 10">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">List 
      interface<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Lists care about the 
      index<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 11">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">ArrayList</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">fastest iteration through 
      items with duplicates<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 12">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">Vector<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">synchronized version of 
      <SPAN class=SpellE>ArrayList</SPAN>; slower<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 13">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">LinkedList</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">addFirst</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(), <SPAN 
      class=SpellE>getFirst</SPAN>()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">doubly linked, ideal for 
      implementing a stack or maintaining an ordered sequence of objects when 
      they are frequently inserted and removed from the middle of the 
      sequence<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 14">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Queu</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
      interface<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">peek() – returns highest 
      priority entry without removing it<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">poll() – returns highest 
      priority entry and removes it<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">offer() – adds 
      entry<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 15">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">PriorityQue</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 16">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">Collections<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Collections.sort</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Collection)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Collections.sort</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Collection, Comparator)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Collections.binarySearch</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>collectionName</SPAN>, pattern) 
      – must be sorted first<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Collections.binarySearch</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>collectionName</SPAN>, pattern, 
      Comparator) – must be sorted first<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Collections.reverse</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – reverses order of elements in List, doesn’t 
      have to be sorted first<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Collections.reverserOrder</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns Comparator that sorts in reverse, must 
      b sorted first<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 17">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">Arrays<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Arrays.sort</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN 
      class=SpellE>arrayToSort</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Arrays.binarySearch</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>arrayName</SPAN>, pattern), 
      <SPAN class=SpellE>Arrays.binarySearch</SPAN>(<SPAN 
      class=SpellE>collectionName</SPAN>, pattern, Comparator) – returns int 
      index<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Arrays.asList</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>arrayName</SPAN>) – returns 
      List, <B style="mso-bidi-font-weight: normal">changes to either returned 
      list or original array will be reflected in the 
      other</B><o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 18">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Comparable 
      interface<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">int <SPAN class=SpellE><B 
      style="mso-bidi-font-weight: normal">compareT</B>o</SPAN>(<SPAN 
      class=SpellE><B 
      style="mso-bidi-font-weight: normal">SpecificObject</B>Type</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">returns <SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp; </SPAN>negative int if this 
      &lt; Obj2<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>0 if Objects are equal<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>positive int if this &gt; Obj2<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 19">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Comparator 
      class<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">int compare(<B 
      style="mso-bidi-font-weight: normal">SpecificObject</B>Type1, <B 
      style="mso-bidi-font-weight: normal">SpecificObject</B>Type2) – returns 
      int with same meaning as above – substitute “SpecificObjectType1” for 
      “this”<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 20; mso-yfti-lastrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.45in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=139>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Iterator</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">boolean</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
      <SPAN class=SpellE>hasNext</SPAN>()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">next() – <B 
      style="mso-bidi-font-weight: normal">returns type Object</B> which must be 
      cast if no generic type is specified for <SPAN 
      class=SpellE>iterator</SPAN>, even if Collection that called <SPAN 
      class=SpellE>iterator</SPAN>() method has generics, like 
      List&lt;Integer&gt;<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Can use generics syntax to 
      avoid explicit casting, e.g. <SPAN class=SpellE>Iterator</SPAN>&lt;Dog&gt; 
      = <SPAN 
  class=SpellE>dogs.iterator</SPAN>();<o:p></o:p></SPAN></P></TD></TR></TBODY></TABLE>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><SPAN 
style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA"><BR 
style="PAGE-BREAK-BEFORE: always" clear=all></SPAN>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt">Dates<o:p></o:p></SPAN></B></P>
<TABLE class=MsoTableGrid 
style="BORDER-RIGHT: medium none; BORDER-TOP: medium none; BORDER-LEFT: medium none; WIDTH: 7.7in; BORDER-BOTTOM: medium none; BORDER-COLLAPSE: collapse; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 480; mso-padding-alt: 0in 5.4pt 0in 5.4pt; mso-border-insideh: .5pt solid windowtext; mso-border-insidev: .5pt solid windowtext" 
cellSpacing=0 cellPadding=0 width=739 border=1>
  <TBODY>
  <TR style="mso-yfti-irow: 0; mso-yfti-firstrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 0.95in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt" 
    vAlign=top width=91>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">java.util.Date</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.75in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt" 
    vAlign=top width=648>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new Date() – date Object 
      with current date<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new Date(long <SPAN 
      class=SpellE>millis</SPAN>) – <SPAN class=SpellE>millis</SPAN> since Jan 
      1, 1970<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getTime</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns long<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">setTime</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(long <SPAN 
      class=SpellE>millis</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">internally stored as 
      primitive long which is milliseconds between date and Jan 1, 
      1970<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 1">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 0.95in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=91>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">Calendar<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.75in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=648>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Calendar.getInstance</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – gets default Calendar (almost always <SPAN 
      class=SpellE>GregorianCalendar</SPAN>) with current 
      time<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Calendar.getInstance</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Locale)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=GramE><SPAN 
      style="FONT-SIZE: 9pt">add(</SPAN></SPAN><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">intField</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">, <SPAN class=SpellE>intAmount</SPAN>) – adds or 
      decrements field.<SPAN style="mso-spacerun: yes">&nbsp; </SPAN><SPAN 
      class=SpellE>intAmount</SPAN> can be negative<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">roll(<SPAN 
      class=SpellE>intField</SPAN>, <SPAN class=SpellE>intAmount</SPAN>) – 
      larger parts of date will not be incremented/decremented, only the field 
      specified<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">set(<SPAN 
      class=SpellE>intField</SPAN>, <SPAN 
      class=SpellE>intValue</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">get(<SPAN 
      class=SpellE>intField</SPAN>) – e.g. <SPAN 
      class=SpellE>calendarInstance.get</SPAN>(<SPAN 
      class=SpellE>Calendar.MONTH</SPAN>);<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">set() – various other set 
      methods<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">setTime</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Date)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getTime</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns Date object, useful for passing to 
      <SPAN class=SpellE>DateFormat</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">setTimeInMillis</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(long <SPAN 
      class=SpellE>millis</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getTimeInMillis</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns long<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">compareTo</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Calendar)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">NO new Calendar(), only 
      instantiated using <SPAN class=SpellE>getInstance</SPAN>(), months are 
      0-based (January is 0)<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 2">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 0.95in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=91>
      <P class=MsoNormal><SPAN class=SpellE><B 
      style="mso-bidi-font-weight: normal"><SPAN 
      style="FONT-SIZE: 9pt">java.text</SPAN></B></SPAN><SPAN 
      style="FONT-SIZE: 9pt">.<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">NumberFormat</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.75in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=648>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">NumberFormat.getInstance</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(), <SPAN 
      class=SpellE>NumberFormat.getInstance</SPAN>(Locale) – e.g. <SPAN 
      class=SpellE>NumberFormat.getInstance</SPAN>(<SPAN 
      class=SpellE>Locale.US</SPAN>);<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN class=GramE><SPAN 
      style="FONT-SIZE: 9pt">NumberFormat.getNumberInstace</SPAN></SPAN></SPAN><SPAN 
      class=GramE><SPAN style="FONT-SIZE: 9pt">(</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">), <SPAN 
      class=SpellE>NumberFormat.getNumberInstanceLocale</SPAN>() – same as <SPAN 
      class=SpellE>getInstance</SPAN>()?<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">NumberFormat.getCurrencyInstance</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(), <SPAN 
      class=SpellE>NumberFormat.getCurrencyInstance</SPAN>(Locale)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">format(long), 
      format(double) – takes various numbers to be formatted, returns 
      String<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">parse(String) – takes a 
      String (must be formatted correctly to locale), returns a Number – e.g. 
      parse(“$5,075”);<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN class=GramE><SPAN 
      style="FONT-SIZE: 9pt">setParseIntegerOnly</SPAN></SPAN></SPAN><SPAN 
      class=GramE><SPAN style="FONT-SIZE: 9pt">(</SPAN></SPAN><SPAN 
      class=SpellE><SPAN style="FONT-SIZE: 9pt">boolean</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">) – whether to format and display digits after 
      decimal.<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getMaximumFractionDigits</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(), <SPAN 
      class=SpellE>getMinimumFractionDigits</SPAN> – get number of decimal 
      places<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">setMaximumFractionDigits</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(int), <SPAN 
      class=SpellE>setMinimumFractionDigits</SPAN> – set number of decimal 
      places <o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">get/<SPAN 
      class=SpellE>setMinimum/MaximumIntegerDigits</SPAN>()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Should only instantiated 
      using <SPAN class=SpellE>getInstance</SPAN>()<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 3">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 0.95in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=91>
      <P class=MsoNormal><SPAN class=SpellE><B 
      style="mso-bidi-font-weight: normal"><SPAN 
      style="FONT-SIZE: 9pt">java.text</SPAN></B></SPAN><SPAN 
      style="FONT-SIZE: 9pt">. <SPAN 
      class=SpellE>DateFormat</SPAN><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.75in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=648>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getInstance</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns <SPAN class=SpellE>DateFormat</SPAN> 
      with default Locale, sometimes SHORT style<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getDateInstance</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() (has defaults, sometimes MEDIUM style),<SPAN 
      class=SpellE>getDateInstance</SPAN>(<SPAN 
      class=SpellE>styleConstant</SPAN>), <SPAN 
      class=SpellE>getDateInstance</SPAN>(<SPAN 
      class=SpellE>styleConstant</SPAN>, Locale)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">parse(String) – converts 
      String to a Date<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">format(Date) – returns 
      String with formatted Date<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><U><SPAN style="FONT-SIZE: 9pt">String format for each 
      style<o:p></o:p></SPAN></U></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">possible default format – 
      0/8/01 7:46 PM<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">DateFormat.SHORT</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> –<SPAN style="mso-spacerun: yes">&nbsp; 
      </SPAN>9/8/01<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">DateFormat.MEDIUM</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> – Sep 8, 2001<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">DateFormat.LONG</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> – September 8, 2001<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">DateFormat.FULL</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> – Saturday, September 8, 
2001<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">There is no <SPAN 
      class=GramE>format(</SPAN>Calendar) method.<SPAN 
      style="mso-spacerun: yes">&nbsp; </SPAN>Calendar must convert to Date 
      first(using <SPAN class=SpellE>yourCalendar.getTime</SPAN>()), then use 
      format(Date)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">DateFormat’s</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> Locale can only be set at instantiation using 
      <SPAN class=SpellE>getInstance</SPAN>() – NO new <SPAN 
      class=SpellE>DateFormat</SPAN>()<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 4; mso-yfti-lastrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 0.95in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=91>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">java.util.Locale</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.75in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=648>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Locale.getDefault</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns default Locale<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new Locale(<SPAN 
      class=SpellE>stringLanguage</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new Locale(<SPAN 
      class=SpellE>stringLanguage</SPAN>, <SPAN 
      class=SpellE>stringCountry</SPAN>) – e.g. new Locale(“it”, 
      “IT”)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">setDefault</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Locale)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getDisplayLanguage</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns String of 
      Language<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getDisplayLanguage</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Locale) – displays language using language of 
      Locale passed in<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getDisplayCountry</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns String code<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getDisplayCountry</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Locale) – displays language using language of 
      Locale passed in)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Locale.getAvailableLocales</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns an array of Locales 
      installed<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">used in Scanner, <SPAN 
      class=SpellE>DateFormat</SPAN>, <SPAN class=SpellE>NumberFormat</SPAN> 
      <o:p></o:p></SPAN></P></TD></TR></TBODY></TABLE>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></B></P><B 
style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA"><BR 
style="PAGE-BREAK-BEFORE: always" clear=all></SPAN></B>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt">String Stuff<o:p></o:p></SPAN></B></P>
<TABLE class=MsoTableGrid 
style="BORDER-RIGHT: medium none; BORDER-TOP: medium none; BORDER-LEFT: medium none; BORDER-BOTTOM: medium none; BORDER-COLLAPSE: collapse; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 480; mso-padding-alt: 0in 5.4pt 0in 5.4pt; mso-border-insideh: .5pt solid windowtext; mso-border-insidev: .5pt solid windowtext" 
cellSpacing=0 cellPadding=0 border=1>
  <TBODY>
  <TR style="mso-yfti-irow: 0; mso-yfti-firstrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.2in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt" 
    vAlign=top width=115>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">String<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 459pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt" 
    vAlign=top width=612>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new String(), new 
      String(<SPAN class=SpellE>StringBuilder</SPAN>/Buffer) 
      <o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new String(“<SPAN 
      class=SpellE>StringLiteral</SPAN>”)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new String(<SPAN 
      class=SpellE>ExistingStringObject</SPAN>) will create a new String object 
      different than <SPAN 
      class=SpellE>ExistingStringObject</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">length()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">charAt</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(int)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">concat</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(String)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">equalsIgnoreCase</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(String)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">substring(<SPAN 
      class=SpellE>intIndex</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">substring(<SPAN 
      class=SpellE>startIntIndex</SPAN>, <SPAN 
      class=SpellE>endIntIndexExclusive</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">replace(char/<SPAN 
      class=SpellE>stringRegex</SPAN>, char/<SPAN 
      class=SpellE>stringReplacement</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">replaceAll</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(char/<SPAN class=SpellE>stringRegex</SPAN>, 
      char/<SPAN class=SpellE>stringReplacement</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">replaceFirst</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>stringRegex</SPAN>, <SPAN 
      class=SpellE>stringReplacement</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">split(<SPAN 
      class=SpellE>regex</SPAN>) – returns String array of tokens, good for just 
      small amount of data<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">split(<SPAN 
      class=SpellE>regex</SPAN>, <SPAN 
      class=SpellE>IntLengthOfArrayReturned</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">toLowerCase</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">toUpperCase</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">trim() – remove whitespace 
      off ends<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">toString</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns a new String 
      object<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">indexOf</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(char/String)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">indexOf</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(char/String, <SPAN 
      class=SpellE>startingIntIndex</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">lastIndex</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(char/String, <SPAN 
      class=SpellE>startingIntIndex</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">lastIndex</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(char/String, <SPAN 
      class=SpellE>startingIntIndex</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">contains(<SPAN 
      class=SpellE>charSequence</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">matches(<SPAN 
      class=SpellE>regex</SPAN>) – returns <SPAN class=SpellE>boolean</SPAN> 
      indicating if <SPAN class=SpellE>regex</SPAN> matches string 
      <o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">boolean</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
      <SPAN class=SpellE>startsWith</SPAN>(String)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">boolean</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
      <SPAN class=SpellE>startsWith</SPAN>(String, <SPAN 
      class=SpellE>offsetIndex</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">String format(“<SPAN 
      class=SpellE>formattingString</SPAN>”, <SPAN class=SpellE>args</SPAN>) – 
      returns String formatted to specs <o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">String format(Locale, 
      “<SPAN class=SpellE>formattingString</SPAN>”, <SPAN 
      class=SpellE>args</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">All methods return a 
      String, do no alter original String<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">NO insert() method (this 
      is in <SPAN 
      class=SpellE>StringBuilder/StringBuffer</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">NO length member variable 
      (this is for array)<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 1">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.2in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=115>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">StringBuilder</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">/ <SPAN 
      class=SpellE>StringBuffer</SPAN><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 459pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=612>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">append(xxx) – can append 
      almost any char related type<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">delete(<SPAN 
      class=SpellE>intStartIndex</SPAN>, <SPAN 
      class=SpellE>intEndIndexExclusive</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">deleteCharAt</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">insert(<SPAN 
      class=SpellE>intOffset</SPAN>, String)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">reverse()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">toString</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">length()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">substring(<SPAN 
      class=SpellE>startIndexInclusive</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">substring(<SPAN 
      class=SpellE>startIndex</SPAN>, <SPAN 
      class=SpellE>endIndexProbablyExclusive</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">lastIndexOf</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(String)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">lastIndexOf</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(String, <SPAN 
      class=SpellE>startSearchIndex</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">replace(<SPAN 
      class=SpellE>intStart</SPAN>, <SPAN class=SpellE>intEnd</SPAN>, 
      String)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">setCharAt</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">StringBuffer</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> is synchronized and slower.<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">StringBuilder</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> is not synchronized and 
      faster<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">equals() method is not 
      overridden, so it compares references, not meaningful values – same as 
      ==<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 2">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.2in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=115>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">java.util</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">.<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">Scanner<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 459pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=612>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new Scanner(File), new 
      Scanner(<SPAN 
      class=SpellE>stringToSearchOrTokenize</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">useDelimiter</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(String) – can be <SPAN 
      class=SpellE>regex</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">useLocal</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Locale)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">hasNext</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(), <SPAN class=SpellE>hasNextInt</SPAN>(), <SPAN 
      class=SpellE>hasNextFloat</SPAN>(), <SPAN class=SpellE>hasNextXxx</SPAN>() 
      – for all primitives EXCEPT char<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">next(), <SPAN 
      class=SpellE>nextInt</SPAN>(), <SPAN class=SpellE>nextFloat</SPAN>(), 
      <SPAN class=SpellE>nextXxx</SPAN> – for all primitives EXCEPT 
      char<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Scanner.close</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – static method that should be used after done 
      with file<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">findInLine</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>regexString</SPAN>) – returns 
      String found<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">match() – returns <SPAN 
      class=SpellE>MatchResult</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">matchResult.groupCount</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – method in <SPAN 
      class=SpellE>MatchResult</SPAN> (not Scanner)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">matchResult.group</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>groupCountIndexInt</SPAN>) – 
      method in <SPAN class=SpellE>MatchResult</SPAN> (not 
      Scanner)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Mostly used for 
      tokenizing, but can also find <SPAN class=SpellE>regexes</SPAN> using 
      <SPAN class=SpellE>findInLine</SPAN>()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Default delimiter is 
      whitespace<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 3">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.2in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=115>
      <P class=MsoNormal><SPAN class=SpellE><B 
      style="mso-bidi-font-weight: normal"><SPAN 
      style="FONT-SIZE: 9pt">java.util.regex</SPAN></B></SPAN><B 
      style="mso-bidi-font-weight: normal"><SPAN 
      style="FONT-SIZE: 9pt">.</SPAN></B><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">Pattern<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 459pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=612>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Pattern.compile</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>regex</SPAN>) – returns new 
      Pattern<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">matcher(<SPAN 
      class=SpellE>CharSequence</SPAN>) – returns new 
      Matcher<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">split(<SPAN 
      class=SpellE>regex</SPAN>) – returns String array of matching patterns 
      found in the <SPAN class=SpellE>CharSequence</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Pattern.matches</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>regex</SPAN>, <SPAN 
      class=SpellE>stringtoSearch</SPAN>) – returns Boolean indicating if string 
      matches <SPAN class=SpellE>regex</SPAN> <o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">/d <SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>digits<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">/s<SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>whitespace<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">/w <SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>word character (letters, digits, or 
      underscores)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
      style="mso-spacerun: yes">&nbsp;</SPAN>[<SPAN class=SpellE>af</SPAN>]<SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>a or f<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
      style="mso-spacerun: yes">&nbsp;</SPAN>[a-f]<SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>a, b, c, d, e, f<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
      style="mso-spacerun: yes">&nbsp;</SPAN>[a-<SPAN 
      class=SpellE>dA</SPAN>-D]<SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN><SPAN class=SpellE>A,a,B,b,C,c,D,d</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">. <SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>any character<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">+<SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>greedy one or more (e.g. /d+ means one or more 
      digits)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">*<SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>greedy zero or more (e.g. filename/d*)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">?<SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN><SPAN class=GramE>greedy</SPAN> zero or more occurrences(e.g. 
      /d?)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">^<SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>not (e.g. [^<SPAN class=SpellE>abc</SPAN>] excludes <SPAN 
      class=SpellE>abc</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">String pattern = “\\d” 
      creates string <SPAN class=SpellE>regex</SPAN> with \d.<SPAN 
      style="mso-spacerun: yes">&nbsp; </SPAN>String pattern = “\\.” creates 
      string <SPAN class=SpellE>regex</SPAN> <SPAN class=GramE>with 
      .</SPAN><o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 4">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.2in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=115>
      <P class=MsoNormal><SPAN class=SpellE><B 
      style="mso-bidi-font-weight: normal"><SPAN 
      style="FONT-SIZE: 9pt">java.util.regex</SPAN></B></SPAN><B 
      style="mso-bidi-font-weight: normal"><SPAN 
      style="FONT-SIZE: 9pt">.</SPAN></B><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">Matcher<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 459pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=612>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">find() – returns <SPAN 
      class=SpellE>boolean</SPAN> indicating a match’s existence, advances to 
      next index that matches, left to right<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">start() – returns starting 
      index<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">group() – returns string 
      that matches<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><U><SPAN style="FONT-SIZE: 9pt">Probably Not on 
      Exam<o:p></o:p></SPAN></U></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">replaceAll</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN 
      class=SpellE>stringReplacement</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">replaceFirst</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN 
      class=SpellE>stringReplacement</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">appendReplacement</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>StringBuffer</SPAN>, <SPAN 
      class=SpellE>stringReplacement</SPAN>) -- <o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">appendTail</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>StringBuffer</SPAN>) – to be 
      used after <SPAN 
      class=SpellE>appendReplacement</SPAN><o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 5; mso-yfti-lastrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 1.2in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=115>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">java.util</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">.<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">Formatter<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 459pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=612>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new Formatter(), new 
      Formatter(<SPAN class=SpellE>Appendable</SPAN>, Locale) – <SPAN 
      class=SpellE>Appendable</SPAN> can be <SPAN 
      class=SpellE>StringBuilder/StringBuffer</SPAN>, <o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">BufferedWriter</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">, <SPAN class=SpellE>FileWriter</SPAN>, but NOT 
      String<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">format(“<SPAN 
      class=SpellE>formattingString</SPAN>”, <SPAN class=SpellE>args</SPAN>) – 
      returns formatted String<o:p></o:p></SPAN></P></TD></TR></TBODY></TABLE>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt">Serialization</SPAN></B><SPAN style="FONT-SIZE: 9pt"> 
(package <SPAN class=SpellE>java.io</SPAN>, classes must implement <SPAN 
class=SpellE>Serializable</SPAN> to be serialized)<o:p></o:p></SPAN></P>
<TABLE class=MsoTableGrid 
style="BORDER-RIGHT: medium none; BORDER-TOP: medium none; BORDER-LEFT: medium none; BORDER-BOTTOM: medium none; BORDER-COLLAPSE: collapse; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 480; mso-padding-alt: 0in 5.4pt 0in 5.4pt; mso-border-insideh: .5pt solid windowtext; mso-border-insidev: .5pt solid windowtext" 
cellSpacing=0 cellPadding=0 border=1>
  <TBODY>
  <TR style="mso-yfti-irow: 0; mso-yfti-firstrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 275.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt" 
    vAlign=top width=367>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">FileOutputStream</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 275.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt" 
    vAlign=top width=367>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new <SPAN 
      class=SpellE>FileOutputStream</SPAN>(<SPAN 
      class=SpellE>stringFileName</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new <SPAN 
      class=SpellE>FileOutputStream</SPAN>(File)<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 1">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 275.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=367>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">ObjectOutputStream</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 275.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=367>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">defaultWriteObject</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">writeObject</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(Object)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">writeInt</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(int), <SPAN class=SpellE>writeFloat</SPAN>(float), 
      <SPAN class=SpellE>writeXxx</SPAN>(xxx)<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 2">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 275.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=367>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">FileInputStream</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 275.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=367>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new <SPAN 
      class=SpellE>FileInputStream</SPAN>(<SPAN 
      class=SpellE>stringFileName</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new <SPAN 
      class=SpellE>FileInputStream</SPAN>(File)<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 3; mso-yfti-lastrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 275.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=367>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">ObjectInputStream</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 275.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=367>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">defaultReadObject</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">readObject</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns Object, must be cast before 
      use<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">readInt</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(), <SPAN class=SpellE>readFloat</SPAN>(), <SPAN 
      class=SpellE>readXxx</SPAN>()<o:p></o:p></SPAN></P></TD></TR></TBODY></TABLE>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Serialization Notes<o:p></o:p></SPAN></U></B></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l8 level1 lfo9; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">For custom 
serialization, must have methods (EXACTLY as shown except parameter names): 
<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>--<B style="mso-bidi-font-weight: normal">private void <SPAN 
class=SpellE><SPAN class=GramE>writeObject</SPAN></SPAN><SPAN 
class=GramE>(</SPAN><SPAN class=SpellE>ObjectOutputStream</SPAN> <SPAN 
class=SpellE>oos</SPAN>)</B>, call <SPAN 
class=SpellE>oos.defaultWriteObject</SPAN>() before trying to do anything else 
in method<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>--<B style="mso-bidi-font-weight: normal">private void <SPAN 
class=SpellE><SPAN class=GramE>readObject</SPAN></SPAN><SPAN 
class=GramE>(</SPAN><SPAN class=SpellE>ObjectInputStream</SPAN> <SPAN 
class=SpellE>ois</SPAN>)</B>, call <SPAN 
class=SpellE>ois.defaultReadObject</SPAN>() before trying to do anything else in 
method<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l8 level1 lfo9; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">If a <SPAN 
class=SpellE>superclass</SPAN> implements <SPAN class=SpellE>Serializable</SPAN> 
all subclasses do automatically<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l8 level1 lfo9; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">If an object within 
a object to be serialized is not <SPAN class=SpellE>serializable</SPAN>, code 
will compile, but a <SPAN class=SpellE>RuntimeException</SPAN> will be 
thrown<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l8 level1 lfo9; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">An object is <SPAN 
class=SpellE>serializable</SPAN> even if <SPAN class=SpellE>superclass</SPAN> is 
not.<SPAN style="mso-spacerun: yes">&nbsp; </SPAN>However, the first <SPAN 
class=SpellE>superclass</SPAN> in the hierarchy that does not implement <SPAN 
class=SpellE>Serializable</SPAN> must have a no-<SPAN class=SpellE>arg</SPAN> 
constructor (that will get called).<SPAN style="mso-spacerun: yes">&nbsp; 
</SPAN>If this is violated, <SPAN class=SpellE>readObject</SPAN>() will produce 
a <SPAN class=SpellE>java.io.InvalidClassException</SPAN> <o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l8 level1 lfo9; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">The (no-<SPAN 
class=SpellE>arg</SPAN>?) <SPAN class=SpellE>contructor</SPAN> of every 
non-<SPAN class=SpellE>serializable</SPAN> <SPAN class=SpellE>superclass</SPAN> 
will run when an object is <SPAN class=SpellE>deserialized</SPAN>.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>However, the <SPAN 
class=SpellE>deserialized</SPAN> objects’ constructor does not run when it is 
<SPAN class=SpellE>deserialized</SPAN>.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l8 level1 lfo9; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">Deserialization</SPAN></SPAN><SPAN 
style="FONT-SIZE: 9pt"> order is FIFO<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l8 level1 lfo9; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Only member 
(instance) variables are serialized<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l8 level1 lfo9; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Static and transient 
member variables are not serialized<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l8 level1 lfo9; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">If a non-<SPAN 
class=SpellE>serializable</SPAN> element is present in a class you are trying to 
serialize, the code will compile but there will be a runtime exception upon 
attempt to serialize<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l8 level1 lfo9; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Filter Streams – 
another name for streams that wrap (get chained to) other 
streams<o:p></o:p></SPAN></P><B style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA"><BR 
style="PAGE-BREAK-BEFORE: always" clear=all></SPAN></B>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt">IO Stuff (<SPAN class=SpellE>java.io</SPAN> 
package)<o:p></o:p></SPAN></B></P>
<TABLE class=MsoTableGrid 
style="BORDER-RIGHT: medium none; BORDER-TOP: medium none; BORDER-LEFT: medium none; BORDER-BOTTOM: medium none; BORDER-COLLAPSE: collapse; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 480; mso-padding-alt: 0in 5.4pt 0in 5.4pt; mso-border-insideh: .5pt solid windowtext; mso-border-insidev: .5pt solid windowtext" 
cellSpacing=0 cellPadding=0 border=1>
  <TBODY>
  <TR style="mso-yfti-irow: 0; mso-yfti-firstrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">File – can be file or 
      directory<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new File(<SPAN 
      class=SpellE>pathNameAndFileString</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new File(<SPAN 
      class=SpellE>pathNameDirString</SPAN>, <SPAN 
      class=SpellE>childPathNameString</SPAN>), new File(File pathname, <SPAN 
      class=SpellE>fileORDirFileString</SPAN>) <o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">createNewFile</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – creates file if doesn’t yet exist, links to 
      existing file, actually creates file on hard drive<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">mkdir</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">exists() – returns <SPAN 
      class=SpellE>boolean</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">isDirectory</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(), <SPAN class=SpellE>isFile</SPAN>() – returns 
      <SPAN class=SpellE>boolean</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">delete() – can only delete 
      directories if they are empty<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">list(), list(<SPAN 
      class=SpellE>FilenameFilter</SPAN>) – returns String 
      array<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">renameTo</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(File) – directory does not have to be empty to 
      rename<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">listFiles</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(), <SPAN class=SpellE>listFiles</SPAN>(<SPAN 
      class=SpellE>FilenameFilter</SPAN>) – returns File 
      array<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getName</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns String<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getPath</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">canRead</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">NO method to change 
      working directory<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 1">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">FileReader</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">read()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">No method for reading line 
      at a time, almost always wrapped with <SPAN 
      class=SpellE>BufferedReader</SPAN><o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 2">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">BufferedReader</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">read(), <SPAN 
      class=SpellE>readline</SPAN>()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Usually wraps around <SPAN 
      class=SpellE>FileReader</SPAN>, No method new <SPAN 
      class=SpellE>BufferredReader</SPAN>(File)<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 3">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">FileWriter</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new <SPAN 
      class=SpellE>FileWriter</SPAN>(File)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new <SPAN 
      class=SpellE>FileWriter</SPAN>(File, <SPAN 
      class=SpellE>appendToEndBoolean</SPAN>) – instead of 
      overwriting<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new <SPAN 
      class=SpellE>FileWriter</SPAN>(<SPAN 
      class=SpellE>fileNameString</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new <SPAN 
      class=SpellE>FileWriter</SPAN>(<SPAN class=SpellE>fileNameString</SPAN>, 
      <SPAN class=SpellE>appendToEndBoolean</SPAN>) – no 
      overwrite<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">write()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">flush()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">close()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Almost always wrapped by 
      (chained to) <SPAN 
    class=SpellE>BufferedWriter</SPAN><o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 4">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">BufferedWriter</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">write()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">newline()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">flush()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">close()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Usually wraps around <SPAN 
      class=SpellE>FileWriter</SPAN><o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 5">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">PrintWriter</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600><PRE><SPAN class=SpellE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">newPrintWriter</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">(File), new <SPAN class=SpellE>PrintWriter</SPAN>(<SPAN class=SpellE>stringFileName</SPAN>), new <SPAN class=SpellE>PrintWriter</SPAN>(Writer), new <SPAN class=SpellE>PrintWriter</SPAN>(<SPAN class=SpellE>OutputStream</SPAN>)<o:p></o:p></SPAN></PRE><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'"><o:p>&nbsp;</o:p></SPAN></PRE><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">write()<o:p></o:p></SPAN></PRE><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">format()/<SPAN class=SpellE>printf</SPAN>()<o:p></o:p></SPAN></PRE><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">print()/<SPAN class=SpellE>println</SPAN>()<o:p></o:p></SPAN></PRE><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">flush(), close()<o:p></o:p></SPAN></PRE><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'"><o:p>&nbsp;</o:p></SPAN></PRE><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">Often wraps around <SPAN class=SpellE>BufferedWriter</SPAN>:<o:p></o:p></SPAN></PRE><PRE><SPAN class=SpellE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">PrintWriter</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'"> out = new <SPAN class=SpellE>PrintWriter</SPAN>(new <SPAN class=SpellE>BufferedWriter</SPAN>(new <SPAN class=SpellE>FileWriter</SPAN>("<SPAN class=SpellE>foo.out</SPAN>")));<o:p></o:p></SPAN></PRE>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">will buffer the <SPAN 
      class=SpellE>PrintWriter's</SPAN> output to the 
    file<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 6">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">FilenameFiler</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> interface<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">accepts(<SPAN class=SpellE>directoryFile</SPAN>, <SPAN class=SpellE>nameString</SPAN>) – returns <SPAN class=SpellE>boolean</SPAN> indicating whether to file passes through filter or not<o:p></o:p></SPAN></PRE><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'"><o:p>&nbsp;</o:p></SPAN></PRE><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">used by File’s list(<SPAN class=SpellE>FilenameFilter</SPAN>) and <SPAN class=SpellE>listFiles</SPAN>(<SPAN class=SpellE>FilenameFilter</SPAN>) methods<o:p></o:p></SPAN></PRE></TD></TR>
  <TR style="mso-yfti-irow: 7; mso-yfti-lastrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">DataInputStream</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">/<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">DataOutputStream</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 6.25in; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=600><PRE><SPAN style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'">Not on exam despite what Sun objectives say– don’t study<o:p></o:p></SPAN></PRE></TD></TR></TBODY></TABLE>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt"><o:p><SPAN 
style="TEXT-DECORATION: none">&nbsp;</SPAN></o:p></SPAN></U></B></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P><B 
style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA"><BR 
style="PAGE-BREAK-BEFORE: always" clear=all></SPAN></B>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
style="FONT-SIZE: 9pt">Other APIs in <SPAN 
class=SpellE>java.lang</SPAN><o:p></o:p></SPAN></B></P>
<TABLE class=MsoTableGrid 
style="BORDER-RIGHT: medium none; BORDER-TOP: medium none; BORDER-LEFT: medium none; WIDTH: 7.45in; BORDER-BOTTOM: medium none; BORDER-COLLAPSE: collapse; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 480; mso-padding-alt: 0in 5.4pt 0in 5.4pt; mso-border-insideh: .5pt solid windowtext; mso-border-insidev: .5pt solid windowtext" 
cellSpacing=0 cellPadding=0 width=715 border=1>
  <TBODY>
  <TR style="mso-yfti-irow: 0; mso-yfti-firstrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">Thread<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: windowtext 1pt solid; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 441pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt" 
    vAlign=top width=588>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">new Thread(), new 
      Thread(<SPAN class=SpellE>stringName</SPAN>), new Thread(<SPAN 
      class=SpellE>runnableTarget</SPAN>), new Thread(<SPAN 
      class=SpellE>runnableTarget</SPAN>, <SPAN 
      class=SpellE>stringName</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Thread.MIN_PRIORITY</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> – usually 1<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Thread.NORM_PRIORITY</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> – usually 5<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Thread.MAX_PRIORITY</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"> – usually 10<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">run() – can be overridden 
      to make new thread, but not recommended<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">start() – causes thread to 
      move to alive state (available to run)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">isAlive</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns <SPAN 
      class=SpellE>boolean</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Thread.sleep</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(long <SPAN class=SpellE>millis</SPAN>) – <B 
      style="mso-bidi-font-weight: normal">throws <SPAN 
      class=SpellE>InterreptedException</SPAN></B><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">join(), join(<SPAN 
      class=SpellE>longMaxTimeToWaitInMillis</SPAN>) – <B 
      style="mso-bidi-font-weight: normal">throws <SPAN 
      class=SpellE>InterruptedException</SPAN></B><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Thread.yield</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – usually shouldn’t be used, but should return 
      current thread back to <SPAN class=SpellE>runnable</SPAN> thread pool if 
      other threads with same or higher priority exist<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">setName</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(String)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Thread.currentThread</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">().<SPAN 
      class=SpellE>getName</SPAN>()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">setPriority</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(int1-10)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">int <SPAN 
      class=SpellE>getPriority</SPAN>()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">getState</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">boolean</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
      <SPAN class=SpellE>holdsLock</SPAN>()<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 1">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">Object<o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 441pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=588>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">wait(), wait(<SPAN 
      class=SpellE>longMaxTimeToWaitInMillis</SPAN>), wait(<SPAN 
      class=SpellE>longMaxTimeToWaitInMillis</SPAN>, <SPAN 
      class=SpellE>intNanosMoreToWait</SPAN>) – <B 
      style="mso-bidi-font-weight: normal">throws <SPAN 
      class=SpellE>InterruptedException</SPAN></B><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt">notify()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">notifyAll</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
      style="FONT-SIZE: 9pt">public</SPAN></B><SPAN style="FONT-SIZE: 9pt"> 
      <SPAN class=SpellE>boolean</SPAN> equals(<SPAN class=SpellE><B 
      style="mso-bidi-font-weight: normal">mustBeObjectNotSubtype</B></SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
      style="FONT-SIZE: 9pt">public</SPAN></B><SPAN style="FONT-SIZE: 9pt"> int 
      <SPAN class=SpellE>hashCode</SPAN>()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
      style="FONT-SIZE: 9pt">public</SPAN></B><SPAN style="FONT-SIZE: 9pt"> 
      String <SPAN class=SpellE>toString</SPAN>()<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 2">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">java.lang.Math</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 441pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=588>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Math.random</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Math.round</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN class=GramE><SPAN 
      style="FONT-SIZE: 9pt">Math.ceil</SPAN></SPAN></SPAN><SPAN 
      class=GramE><SPAN style="FONT-SIZE: 9pt">(</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">) -- Returns the smallest (closest to negative 
      infinity) </SPAN><CODE><SPAN 
      style="FONT-SIZE: 9pt">double</SPAN></CODE><SPAN style="FONT-SIZE: 9pt"> 
      value that is greater than or equal to the argument and is equal to a 
      mathematical integer.<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN class=GramE><SPAN 
      style="FONT-SIZE: 9pt">Math.floor</SPAN></SPAN></SPAN><SPAN 
      class=GramE><SPAN style="FONT-SIZE: 9pt">(</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">) -- Returns the largest (closest to positive 
      infinity) </SPAN><CODE><SPAN 
      style="FONT-SIZE: 9pt">double</SPAN></CODE><SPAN style="FONT-SIZE: 9pt"> 
      value that is less than or equal to the argument and is equal to a 
      mathematical integer.<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Math.round</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Math.sqrt</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Math.max</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(number, number)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Math.min</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(number, number)<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 3">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">java.lang.Enum</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 441pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=588>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">ordinal() – prints 
      position (zero-based), similar to index for an array<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>e.g. <SPAN 
      class=SpellE>enumName.ordinal</SPAN>();<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">Enums</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> in 
      case statement should NOT use class prefix, but everywhere else should 
      have prefix (e.g. <SPAN class=SpellE>Grade.A</SPAN>), unless <SPAN 
      class=SpellE>enum</SPAN> is in the same class<o:p></o:p></SPAN></P></TD></TR>
  <TR style="mso-yfti-irow: 4; mso-yfti-lastrow: yes">
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: windowtext 1pt solid; WIDTH: 95.4pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=127>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">java.lang.System</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P></TD>
    <TD 
    style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 5.4pt; BORDER-TOP: medium none; PADDING-LEFT: 5.4pt; PADDING-BOTTOM: 0in; BORDER-LEFT: medium none; WIDTH: 441pt; PADDING-TOP: 0in; BORDER-BOTTOM: windowtext 1pt solid; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt" 
    vAlign=top width=588>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.out.println</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.out.print</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">()<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.out.format/printf</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(“string with %below”, <SPAN 
      class=SpellE>argsToString</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.exit</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN 
      class=SpellE>intStatus</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.getenv</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns Map of all environment variables 
      <o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.getenv</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN 
      class=SpellE>stringEnvironmentVariable</SPAN>) – returns value for 
      specified environment variable <o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.getProperty</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN 
      class=SpellE>stringKey</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.getProperties</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – returns Property object (subclass of <SPAN 
      class=SpellE>Hashtable</SPAN>) containing all 
      properties<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.setProperties</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN class=SpellE>stringKey</SPAN>, <SPAN 
      class=SpellE>stringValue</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.setProperties</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">(<SPAN 
      class=SpellE>PropertyObject</SPAN>)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN class=SpellE><SPAN 
      style="FONT-SIZE: 9pt">System.gc</SPAN></SPAN><SPAN 
      style="FONT-SIZE: 9pt">() – same as <SPAN 
      class=SpellE>Runtime.getRuntime</SPAN>().<SPAN class=SpellE>gc</SPAN>() – 
      requests (but may not obtain) garbage collection<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN 
      style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
      <P class=MsoNormal><U><SPAN style="FONT-SIZE: 9pt">For Formatting with 
      format()/<SPAN class=SpellE>printf</SPAN>()</SPAN></U><SPAN 
      style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
      <P class=MsoNormal><B style="mso-bidi-font-weight: normal"><SPAN 
      style="FONT-SIZE: 9pt">%[<SPAN 
      class=SpellE>arg_index</SPAN>$][flags][width][.precision]<SPAN 
      class=SpellE>conversionCharacter</SPAN><o:p></o:p></SPAN></B></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
      style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN><SPAN 
      style="mso-spacerun: yes">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>-,+,0,,,(<SPAN style="mso-spacerun: yes">&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN><SPAN 
      style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN><SPAN 
      style="mso-spacerun: yes">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</SPAN><SPAN 
      class=SpellE>b,c,d,f,s,S</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">- Left justify<SPAN 
      style="mso-tab-count: 5">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>b <SPAN class=SpellE>boolean</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">+ Include sign<SPAN 
      style="mso-tab-count: 5">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>c char<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">0 Pad with zeros<SPAN 
      style="mso-tab-count: 5">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>d integer (digit)<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">, Use locale-specific 
      grouping separators<SPAN 
      style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>f float<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">( negatives in 
      parentheses<SPAN 
      style="mso-tab-count: 4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>s string<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
      style="mso-tab-count: 6">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
      </SPAN>S CAPITALIZE the string<o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">%<SPAN 
      class=SpellE>illigitChar</SPAN> results in <SPAN 
      class=SpellE>java.util.UnknownFormatConversionException</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Wrong format results in 
      <SPAN 
      class=SpellE>IllegalFormatConversionException</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Can have more arguments 
      than conversions, but more conversions than arguments results in <SPAN 
      class=SpellE>java.util.Missing</SPAN> <SPAN 
      class=SpellE>FormatArgumentException</SPAN><o:p></o:p></SPAN></P>
      <P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">You can’t use an int 
      literal argument for %f <o:p></o:p></SPAN></P></TD></TR></TBODY></TABLE>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P><B 
style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA"><BR 
style="PAGE-BREAK-BEFORE: always" clear=all></SPAN></U></B>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Primitives, <SPAN 
class=SpellE>WrappersAssignments</SPAN>, <SPAN 
class=SpellE>Autoboxing</SPAN><o:p></o:p></SPAN></U></B></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">new XXX(String), new 
XXX(primitive) -- wrapper class constructors all take corresponding primitives 
or strings as arguments (e.g. new Long(“12”) or new 
Long(12))<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">XXX.valueof</SPAN></SPAN><SPAN 
style="FONT-SIZE: 9pt">(String),<SPAN style="mso-spacerun: yes">&nbsp; 
</SPAN><SPAN class=SpellE>XXX.valueOf</SPAN>(String, <SPAN 
class=SpellE>intRadixBase</SPAN>) – static method returns XXX wrapper type 
<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">parseXxx</SPAN></SPAN><SPAN 
style="FONT-SIZE: 9pt">(String) – static method returns primitive of type 
Xxx<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">xxxValue</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> -- 
converts wrapper to any primitive xxx type, truncates and does NOT 
round<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">table on p. 
233<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">integer literals are 
always interpreted as int types by the JVM, number literals with decimals are 
interpreted as doubles<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">byte – 8 bits, short 
– 16 bits, int – 32 bits, long – 64 bits, float – 32 bits, double – 64 bits, 
char – 16 bits (but can’t fit into a short because it has a bigger positive 
range than short since there are no negatives)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">no static member can 
use a generic type parameter declared by the enclosing 
class<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Calling run() method 
will not create a separate thread, and <SPAN 
class=SpellE>Thread.currentThread</SPAN>().<SPAN class=SpellE>getName</SPAN>() 
of the thread in run() will be “main”<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Variables and 
classes can’t be synchronized, but instance methods, static methods, and any 
code block within a method (enclose in {}) can be 
synchronized<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Conditional 
operators (==, &lt;, &gt;) have higher precedence than assignment operators, so 
“if (b = x == y)” can be a legal statement<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Wrappers with values 
over 127 are unique, so “new Integer(130) == new Integer(130)” returns false, 
but “new Integer(120)” == new Integer(120)” returns true<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">WrapperClass.equals</SPAN></SPAN><SPAN 
style="FONT-SIZE: 9pt">(<SPAN class=SpellE>AnyOtherClass</SPAN>) = false, <SPAN 
class=SpellE>String.equals</SPAN>(<SPAN class=SpellE>anyNonString</SPAN>) = 
false, <SPAN class=SpellE>StringBuffer.equals</SPAN>(<SPAN 
class=SpellE>AnyOtherObjectRef</SPAN>) = false (<SPAN 
class=SpellE>StringBuffer</SPAN> does not override equals 
method)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">0 % 4 = 
0<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">new Boolean(“<SPAN 
class=SpellE>anyMessage</SPAN>”); will create a Boolean with 
false<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Trying to <SPAN 
class=SpellE>unbox</SPAN> a null will result in a <SPAN 
class=SpellE>NullPointerException</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=GramE><SPAN 
style="FONT-SIZE: 9pt">if</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> there are 
multiple ++x <SPAN class=SpellE>incrementors</SPAN> in a compound expression, 
each is incremented before that part of the expression?<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">For Boolean <SPAN 
class=SpellE>bool</SPAN> = new Boolean(“TRUE”), in both if (<SPAN 
class=SpellE>bool</SPAN>) and if (<SPAN class=SpellE>bool</SPAN> == true), <SPAN 
class=SpellE>bool</SPAN> is unboxed automatically<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Number, <SPAN 
class=SpellE>StringBuffer/StringBuilder</SPAN> DO NOT override equals() and 
<SPAN class=SpellE>hashCode</SPAN>() and inherit these from Object (so .equals() 
for different objects with the same values evaluates to 
false)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">For array 
instantiation, array size must be specified (INCORRECT – in <SPAN 
class=SpellE>myArray</SPAN>[] = new int[])<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">Vararg</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> methods 
CAN be invoked with 0 or more arguments<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Integer can be boxed 
to int and vice-versa<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Integer[] CAN NOT be 
boxed to int[] and int[] CAN NOT be boxed into Integer[]<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">ILLEGAL – int[] 
values = new int[2] {1,2}; LEGAL – int[] values = new int[] 
{1,2};<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">To calculate -5 % 
-2, drop negatives, calculate remainder, then modify answer to have the same 
sign as operand on the left<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Casting floating 
point numbers to non-floats (e.g. int I = (int) 23.4f) truncates (does not 
round).<SPAN style="mso-spacerun: yes">&nbsp; </SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">In primitive 
casting, <SPAN class=GramE>If</SPAN> value is too big, higher order bits 
(furthest left) are truncated.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">(x=5) returns 5, so 
<SPAN class=SpellE>System.out.println</SPAN>(x=5) will print 
“5”<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Wrappers can’t widen 
to other Number types (Integer can NOT widen to LONG, Short can NOT widen to 
INTEGER)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">You can box and then 
widen (int </SPAN><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Wingdings; mso-ascii-font-family: 'Times New Roman'; mso-hansi-font-family: 'Times New Roman'; mso-char-type: symbol; mso-symbol-font-family: Wingdings"><SPAN 
style="mso-char-type: symbol; mso-symbol-font-family: Wingdings">à</SPAN></SPAN><SPAN 
style="FONT-SIZE: 9pt"> Number), but you can NOT widen and then box (int 
</SPAN><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Wingdings; mso-ascii-font-family: 'Times New Roman'; mso-hansi-font-family: 'Times New Roman'; mso-char-type: symbol; mso-symbol-font-family: Wingdings"><SPAN 
style="mso-char-type: symbol; mso-symbol-font-family: Wingdings">à</SPAN></SPAN><SPAN 
style="FONT-SIZE: 9pt"> Long)<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Modifiers, Keywords, Declarations, and 
Assignments</SPAN></U></B><SPAN style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">interface methods 
are public and abstract whether they say so or not – explicit declaration is 
optional, and using any other access modifiers will not 
compile<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">interface methods 
can’t be static or final, and variables can’t be private or protected (but they 
can be static)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">interface variables 
are implicitly public, static, and final (they are constants), whether it is 
indicated or not – explicit declaration is optional, and using any other access 
modifiers will not compile<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Legal to do String s 
= null; s += “”; if printed will print “null”<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">When assigning array 
references to arrays, dimensions of array matter, number of indices in each 
array doesn’t<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>e.g.</SPAN> <SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>short[</SPAN>][] b = new short [4][4]; 
<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>short</SPAN> b2 [][][][] = new short [2][3][2][2]; 
<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>b2 [1<SPAN class=GramE>][</SPAN>0] = b;<SPAN 
style="mso-tab-count: 3">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>//This is legal<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Even using static 
imports, a non-subclass object from a different package, can’t access non-public 
static methods and variables<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Can’t have a static 
method and non-static method with otherwise same signature in same 
class<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">LEGAL – public 
static int x = <SPAN class=SpellE>getValue</SPAN>(); (if <SPAN 
class=SpellE>getValue</SPAN> is static)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">int[] <SPAN 
class=SpellE>myArray</SPAN>[] is legal declaration for 2-D 
array<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Less Common 
Keywords:<SPAN style="mso-spacerun: yes">&nbsp; </SPAN><SPAN 
class=SpellE>strictfp</SPAN>, const, <SPAN class=SpellE>goto</SPAN>, native, 
transient, volatile, assert, <SPAN class=SpellE>enum</SPAN>, <SPAN 
class=SpellE>instanceof</SPAN> (an operator NOT a method, <SPAN 
class=SpellE>instanceOf</SPAN> is OK)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">“native” only 
applies to methods and “<SPAN class=SpellE>strictfp</SPAN>” only applies to 
classes and methods<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">“<SPAN 
class=GramE>volatile</SPAN>” and “transient” modifiers only apply to instance 
variables.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN class=GramE><SPAN 
style="FONT-SIZE: 9pt">vararg</SPAN></SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
parameters can take the specified type AND arrays of the specified type.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>e.g. (String …<SPAN 
class=SpellE>myVar</SPAN>) can take several strings or a String[] 
array<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Trying to change the 
value of a final variable results in failed compilation<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">JavaBeans standards 
– <SPAN class=SpellE>camelCase</SPAN> and <SPAN class=SpellE>getXxx</SPAN>(), 
<SPAN class=SpellE>setXxx</SPAN>(), <SPAN class=SpellE>isXxx</SPAN>(), <SPAN 
class=SpellE>addXxx</SPAN>(), <SPAN 
class=SpellE>removeXxx</SPAN>()<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">final is the only 
legal modifier available for local variables<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">There can only be 1 
<SPAN class=SpellE>vararg</SPAN> in a parameter declaration, and it must come 
last in the parameter list of a method declaration<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">In a <SPAN 
class=SpellE>vararg</SPAN> declaration, the space can be after the type, before 
the variable name, or nonexistent – e.g. (String… value), (String …value), or 
(String…value)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l1 level1 lfo3; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Access modifiers and 
other modifiers can be listed in any order (but before the return type in 
methods).<SPAN style="mso-spacerun: yes">&nbsp; </SPAN>“public static void” and 
“static public void” both work<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">In a switch 
statement, the argument to the switch statement must be a byte, short, <SPAN 
class=GramE>char ,</SPAN> int, long, and <SPAN class=SpellE>enum</SPAN>.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>The arguments to the case statements 
must be <SPAN class=SpellE>constats</SPAN>: int-literals, static final int 
variables, or <SPAN class=SpellE>enums</SPAN>.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>They can be the result of arithmetic 
with the above as well (e.g. <SPAN class=SpellE>staticFinalVariable</SPAN> – 
1).<SPAN style="mso-spacerun: yes">&nbsp; </SPAN>Any variation from this will 
not compile.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l9 level1 lfo2; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">“break outer;” means 
break out of the outer loop (not break to the outer loop)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l9 level1 lfo2; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">For an object 
declared final, the reference can NOT be changed, but the object it refers to 
CAN be changed<o:p></o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt"><o:p><SPAN 
style="TEXT-DECORATION: none">&nbsp;</SPAN></o:p></SPAN></U></B></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Inheritance, Polymorphism, Overloading, IS-A HAS-A 
stuff</SPAN></U></B><SPAN style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">super only applies 
to calling overridden methods (and only non-private, non-static methods can be 
overridden,<SPAN style="mso-spacerun: yes">&nbsp; </SPAN>private methods are 
hidden from subclasses)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Member variables are 
not overridden, but they can be legally shadowed, which is bad 
practice<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Polymorphism 
(different behavior depending on subclass type for <SPAN 
class=SpellE>superclass</SPAN> object reference) applies only to instance 
methods NOT static methods, and never to static or member 
variables.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Static methods can 
be shadowed (redefined) but are not “overridden” by subclasses.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>Static (and static final) variables can 
also be shadowed (but variables are NEVER overridden).<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>However, if method1() is a static 
shadowed method in car, in the code “Car c = new Honda(); c.method1()” will 
execute the method1 in the Car <SPAN class=SpellE>superclass</SPAN>, not the 
Honda subclass<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">HAS-A relationships 
include static member variables<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Casts are not 
checked by the compiler, so illegal casts will compile fine but produce runtime 
exceptions<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">The keyword “this” 
refers to the currently executing OBJECT, so it can be called from within static 
code<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Calling an 
overridden method always invokes the method “nearest” to the class 
instance<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">For overloaded 
methods, <SPAN class=SpellE>autoboxing</SPAN> beats out <SPAN 
class=SpellE>varargs</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=GramE><SPAN 
style="FONT-SIZE: 9pt">super</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> keyword 
applies to subclasses accessing <SPAN class=SpellE>superclasses</SPAN>, not for 
inner classes.<SPAN style="mso-spacerun: yes">&nbsp; </SPAN>For inner classes to 
access outer class variables with the same names as inner class variables, the 
class <SPAN class=SpellE>name.this</SPAN> must be used (e.g. <SPAN 
class=SpellE>OuterClassName.this.variabeName</SPAN>)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">implementing classes 
and subclasses do NOT have to explicitly declare exceptions of <SPAN 
class=SpellE>superclasses</SPAN> and implemented 
interfaces<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Overriding methods 
can NOT declare any new unchecked exceptions or <SPAN 
class=SpellE>breader</SPAN> checked exceptions than the overridden method, but 
they can declare any new runtime exceptions or errors (which are also unchecked 
but <SPAN class=SpellE>Throwable</SPAN>) <o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Encapsulation, coupling, 
cohesion<o:p></o:p></SPAN></U></B></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Good encapsulation 
promotes loose coupling<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Coupling is not used 
to evaluate classes within the same inheritance tree<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Encapsulations 
limits the consequences of change<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Encapsulation allows 
corrections to a class with minimal impact to users of that 
class<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Encapsulation (and 
high cohesion) makes it easier to reuse classes<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Encapsulation 
results in better testing and higher reliability<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Cohesion refers to 
the number and diversity of tasks that a single unit is responsible for.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>A class with one task has high cohesion 
an any method not focused on a single task shows low 
cohesion<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Coupling is how 
linked and non-independent together two classes are.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>Loose coupling helps understand one 
class without studying the others and minimizes changes in one class when 
another class is changed.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">For method 
arguments, passing in specific, user-created objects requires tight coupling, 
since the two objects involved both need to know something about the object 
being passed in<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Collections, <SPAN class=GramE>equals(</SPAN>), and <SPAN 
class=SpellE>hashCode</SPAN>()</SPAN></U></B><SPAN 
style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">In order to sort and 
array or collection, elements must be mutually comparable (same type) – trying 
to sort different objects will result in runtime exception<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">The more unique the 
<SPAN class=SpellE>hashcode</SPAN>, the faster the 
retrieval<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">the equals() method 
for an object must be at least as precise as the <SPAN 
class=SpellE>hashcode</SPAN>() method (equals() and <SPAN 
class=SpellE>hashcode</SPAN>() CAN use the exact same 
algorithm)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">.equals() should 
return false for an object of a different type (but compiles and runs without 
exceptions) <o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">HashSet</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> and 
<SPAN class=SpellE>LinkedHashSet</SPAN> can have null elements, <SPAN 
class=SpellE>TreeSet</SPAN> can’t (it has to sort)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">HashMap</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> and 
<SPAN class=SpellE>LinkedHashMap</SPAN> can have a null key and null values, 
<SPAN class=SpellE>TreeMap</SPAN> can have null values but NOT null keys, and 
<SPAN class=SpellE>Hashtable</SPAN> can have neither null keys or null 
values<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">For non-generic 
<SPAN class=SpellE>TreeSet</SPAN>, putting objects of different types will 
compile fine, but this will produce a runtime error<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">For any generics, 
trying to add the wrong type will not compile (e.g. trying to add a String when 
&lt;Integer&gt; was specified&gt;<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">When you try to add 
objects without a “<SPAN class=SpellE>compareTo</SPAN>” method to a Set, code 
will compile fine but a <SPAN class=SpellE>ClassCastException</SPAN> will be 
thrown at runtime (trying to cast object to a Comparable)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">It is LEGAL to 
assign generic type collections to raw type collections, e.g. Vector v = new 
Vector&lt;Integer&gt;()<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Trying to add an 
object that does not implement comparable to an sorted collection (Tree prefix) 
will not compile<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l5 level1 lfo1; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Natural ordering of 
Strings from low to high: space, numbers, all uppercase letters, underscore, all 
lowercase letters<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Generics</SPAN></U></B><SPAN 
style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Legal generic method 
declaration:<SPAN style="mso-spacerun: yes">&nbsp; </SPAN>public static &lt;X, Y 
extends X&gt; <SPAN class=SpellE>boolean</SPAN> <SPAN 
class=SpellE>isPresent</SPAN>(X <SPAN class=SpellE>x</SPAN>, Y[] 
Y)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Generic types 
(within “<SPAN class=GramE>&lt;<SPAN style="mso-spacerun: yes">&nbsp; 
</SPAN>&gt;</SPAN>”) do not get <SPAN class=SpellE>upcast</SPAN> by the 
compiler, but base types (before the “&lt; &gt;”) using generics can be 
implicitly <SPAN class=SpellE>upcast</SPAN> (and 
downcast?)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">&lt;? extends 
Animal&gt; means the generic can be assigned an Animal or any subclass of 
Animal<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">&lt;? super 
Animal&gt; means the generic can be assigned an Animal or any <SPAN 
class=SpellE>superclass</SPAN> of Animal<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">List&lt;?&gt; is the 
same as (means) List&lt;? extends Object&gt;<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">You cannot add 
objects to a Collection using generics &lt;?&gt; syntax.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>Compilation will fail if the generic 
type is not known at compile time.<SPAN style="mso-spacerun: yes">&nbsp; 
</SPAN>However, you can add to Collections using generics with &lt;? extends 
<SPAN class=SpellE>MyObject</SPAN>&gt; syntax<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">In method 
declaration that can accept generics syntax, generics must be declared before 
the return type: public &lt;T&gt; void <SPAN class=SpellE>makelist</SPAN>(T 
<SPAN class=SpellE>t</SPAN>){}<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">&lt;T super Dog&gt; 
not &lt;? super Dog&gt;<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">It is VALID to 
assign non-generic classes to generic classes <SPAN 
class=SpellE>LinkedList</SPAN>&lt;Integer&gt; <SPAN class=SpellE>IList</SPAN> = 
new <SPAN class=SpellE>LinkedList</SPAN>() – gives warnings on compilation but 
runs without errors<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P><B 
style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA"><BR 
style="PAGE-BREAK-BEFORE: always" clear=all></SPAN></U></B>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Exceptions</SPAN></U></B><SPAN 
style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Exceptions that are 
not handled <SPAN class=SpellE>propogate</SPAN> (from main they <SPAN 
class=SpellE>propogate</SPAN> to the terminal) AFTER any 
finally<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">Throwable</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> is a 
class and NOT an interface, so it’s LEGAL to write new <SPAN 
class=SpellE>Throwable</SPAN>()<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Programmers 
frequently throw <SPAN class=SpellE>IllegalStateException</SPAN>, <SPAN 
class=SpellE>NumberFormatException</SPAN>, and <SPAN 
class=SpellE>IllegalArgumentException</SPAN>, <SPAN 
class=SpellE>AssertionError</SPAN>, not the JVM.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>Know when to throw 
these.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">JVM usually throws 
<SPAN class=SpellE>NullPointerException</SPAN>, <SPAN 
class=SpellE>ArrayIndexOutOfBoundsException</SPAN>, <SPAN 
class=SpellE>ClassCastException</SPAN>, <SPAN 
class=SpellE>ExceptionInInitializerError</SPAN>, <SPAN 
class=SpellE>StackOverflowError</SPAN>, <SPAN 
class=SpellE>NoClassDefFoundError</SPAN>, and any other Error.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>Know when these are 
thrown.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">catch(Exception e) 
{} will catch all exceptions, including Runtime Exceptions that don’t need to be 
caught to compile<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">FileNotFoundException</SPAN></SPAN><SPAN 
style="FONT-SIZE: 9pt"> extends <SPAN class=SpellE>IOException</SPAN> (which is 
a <SPAN class=SpellE>RuntimeException</SPAN>)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l0 level1 lfo10; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Constructors can 
throw exceptions<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Command Line/Dev Environment Stuff</SPAN></U></B><SPAN 
style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l2 level1 lfo11; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">For running programs 
from the command line, the <SPAN class=SpellE>classpath</SPAN> must include the 
directory to find the class file of the specified program (containing main) and 
the directories (root directory of any packages) for finding any class files 
referenced by the main program<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l2 level1 lfo11; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Can’t call “<SPAN 
class=SpellE>super.super.someMethod</SPAN>()” – will not 
compile<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l2 level1 lfo11; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">It is LEGAL to 
import only static methods with static imports – e.g. “import static <SPAN 
class=SpellE>java.util.Collections.sort</SPAN>”, then in code “sort(<SPAN 
class=SpellE>arrayList</SPAN>)”<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l2 level1 lfo11; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Static imports must 
include, either with a wildcard (*) or explicitly, the members that will be 
referenced.<SPAN style="mso-spacerun: yes">&nbsp; </SPAN>So “import static <SPAN 
class=SpellE>java.lang.Math</SPAN>” is not a valid static import, but “import 
static <SPAN class=SpellE>java.lang.Math</SPAN>.*;” or “import static <SPAN 
class=SpellE>java.lang.Math.random</SPAN>” are valid static 
imports<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l2 level1 lfo11; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">jar files and 
“-<SPAN class=SpellE>classpath</SPAN>” (or “–<SPAN class=SpellE>cs</SPAN>”) can 
be used with both java and <SPAN class=SpellE>javac</SPAN> 
<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l2 level1 lfo11; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Command line calls 
to run a class (using java) must include package names (e.g. java –cp classes 
<SPAN class=SpellE>com.players.MusicPlayer</SPAN>)<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Threads</SPAN></U></B><SPAN 
style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Thread name does NOT 
have to be unique<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">To synchronize 
correctly, usually synchronize in method declaration, on “this”, or on a static 
object, but do NOT choose instance or local variables since each object has 
<SPAN class=GramE>it’s</SPAN> own lock.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">A synchronized 
method can be overridden by a non-synchronized method and 
vice-versa<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Abstract methods 
can’t be synchronized<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Objects have locks, 
Threads do NOT have locks<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Collections 
Framework interfaces CAN’T be serialized (probably no interface can be 
serialized?), but all of the implementing classes can<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Invoking start() 
multiple times on a thread will compile but throw an <SPAN 
class=SpellE>IllegalThreadStateException</SPAN> at runtime<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Only methods and 
blocks can have synchronized modifier, not variables or classes.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>However, you can synchronize on (the 
lock of) an object that may be a variable using synchronized(<SPAN 
class=SpellE>myObject</SPAN>) – synchronizes on lock of <SPAN 
class=SpellE>myObject</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">synchronized(this) 
says to synchronize on current object and synchronized(<SPAN 
class=SpellE>MyClass.class</SPAN>) synchronized on the class (it’s equivalent to 
synchronizing a static method) <o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">There are separate 
locks for the class (just one for class) and for the objects of the class (can 
be many for objects – 1 for each object)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">A thread must have a 
lock on the object on which the wait() method is to be invoked (but then it 
gives up the lock as soon as wait() is invoked)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Call start() on a 
Thread instance, not a <SPAN class=SpellE>Runnable</SPAN> 
instance<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l13 level1 lfo13; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">A lock is not 
released when a thread goes to sleep<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Assertions</SPAN></U></B><SPAN 
style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">It’s considered OK 
to throw <SPAN class=SpellE>AssertionError</SPAN> explicitly (why? does this 
mean outside of an assertion)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">OK to use assertions 
to verify the arguments of private methods<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Assertions 
statements should not alter the value of any variable.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">the expression after 
the “:” in an assert statement must have a value, so a method call must have a 
return value, and after the colon can’t be empty<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">For assertions to 
execute, code needs to be both compiled AND run with assertions 
enabled<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Inner Classes<o:p></o:p></SPAN></U></B></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Inner classes can be 
abstract, and any abstract methods in abstract classes can be defined with a 
concrete anonymous subclass<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Correct static 
“inner” class instantiation syntax:<SPAN style="mso-spacerun: yes">&nbsp; 
</SPAN>new <SPAN class=SpellE><SPAN 
class=GramE>Outer.TestInner</SPAN></SPAN><SPAN class=GramE>(</SPAN>) – 
constructor for Outer will never run.<SPAN style="mso-spacerun: yes">&nbsp; 
</SPAN>If it’s not a static inner class, then syntax needs to be new Outer().new 
<SPAN class=SpellE>TestInner</SPAN>()<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal style="tab-stops: 95.25pt"><B 
style="mso-bidi-font-weight: normal"><U><SPAN style="FONT-SIZE: 9pt">Garbage 
Collection and <SPAN class=GramE>finalize()</SPAN><o:p></o:p></SPAN></U></B></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l12 level1 lfo14; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Garbage Collection 
is performed by a daemon thread<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l12 level1 lfo14; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">An object created 
and accessed locally may only be eligible for garbage collection when the method 
returns IF the object is not passed out of the method<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l12 level1 lfo14; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">If an array of size 
2 that refers to 2 objects is eligible for garbage collection, then 3 objects 
are actually eligible for <SPAN class=SpellE>gc</SPAN> – the array object and 
the 2 objects it references<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l12 level1 lfo14; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">When an object is 
passed to an unseen method, we can’t be sure the object is eligible for <SPAN 
class=SpellE><SPAN class=GramE>gc</SPAN></SPAN> anywhere below the 
method-calling code, b/c the method could pass the object on to 
threads.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l12 level1 lfo14; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">The <SPAN 
class=GramE>finalize(</SPAN>) method can be overloaded, but only the no-<SPAN 
class=SpellE>arg</SPAN> finalize() method will be called by the 
JVM.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l12 level1 lfo14; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">The finalize() 
method is usually used to free up resources other than 
memory<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l12 level1 lfo14; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Live object 
references in a finalize() method can “resurrect” an 
object<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l12 level1 lfo14; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">The <SPAN 
class=GramE>finalize(</SPAN>) method is guaranteed to run once and only once 
before the garbage collector deletes an object.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>However, there is no guarantee that the 
object will ever be garbage collected, so there is no guarantee that <SPAN 
class=GramE>finalize(</SPAN>) will run.<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt"><o:p><SPAN 
style="TEXT-DECORATION: none">&nbsp;</SPAN></o:p></SPAN></U></B></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt"><o:p><SPAN 
style="TEXT-DECORATION: none">&nbsp;</SPAN></o:p></SPAN></U></B></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt"><o:p><SPAN 
style="TEXT-DECORATION: none">&nbsp;</SPAN></o:p></SPAN></U></B></P><B 
style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA"><BR 
style="PAGE-BREAK-BEFORE: always" clear=all></SPAN></U></B>
<P class=MsoNormal><SPAN class=SpellE><B 
style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Enums</SPAN></U></B></SPAN><B 
style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></U></B></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l10 level1 lfo8; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">myEnum.valueOf</SPAN></SPAN><SPAN 
style="FONT-SIZE: 9pt">(String) – returns value of corresponding <SPAN 
class=SpellE>enum</SPAN> value<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l10 level1 lfo8; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">yourEnum.values</SPAN></SPAN><SPAN 
style="FONT-SIZE: 9pt">() lists all the possible values of <SPAN 
class=SpellE>yourEnum</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l10 level1 lfo8; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">Enums</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> can have 
instance/member variables, constructors, and methods <o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l10 level1 lfo8; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">Enums</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
constructors can have a constant specific class body (a method that overrides 
one of the methods), but not any new methods? or any method 
calls<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l10 level1 lfo8; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">In an <SPAN 
class=SpellE>enum</SPAN> declaration, multiple constant-specific methods for 
each enumerated type must be separated by commas and terminated by a 
semi-colon:<SPAN style="mso-spacerun: yes">&nbsp; </SPAN>e.g. <SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=SpellE>enum</SPAN> VALUE{ MAX {int <SPAN 
class=SpellE>returnIt</SPAN>(int x) {return 10}; },<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN 
style="mso-spacerun: yes">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>MIN {int <SPAN class=SpellE><SPAN class=GramE>returnIt</SPAN></SPAN><SPAN 
class=GramE>{</SPAN>(int x) {return 1};};}<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">enums</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> can be 
imported using “import <SPAN class=SpellE>package.EnumClass</SPAN>.*”, “import 
<SPAN class=SpellE>package.EnumClassor.EnumName</SPAN>”, “import static” 
versions<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l4 level1 lfo6; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">enum</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
constructors can <SPAN class=SpellE>neber</SPAN> be invoked directly from 
code<o:p></o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt"><o:p><SPAN 
style="TEXT-DECORATION: none">&nbsp;</SPAN></o:p></SPAN></U></B></P>
<P class=MsoNormal><U><SPAN style="FONT-SIZE: 9pt">Simple 
Example<o:p></o:p></SPAN></U></P>
<P class=MsoNormal><SPAN class=SpellE><SPAN class=GramE><SPAN 
style="FONT-SIZE: 9pt">enum</SPAN></SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
Month{NOV, DEC, JAN};<SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>// The semi-colon at the end in this case is 
optional<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><U><SPAN style="FONT-SIZE: 9pt">More 
Complex<o:p></o:p></SPAN></U></P>
<P class=MsoNormal><SPAN class=SpellE><SPAN class=GramE><SPAN 
style="FONT-SIZE: 9pt">enum</SPAN></SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> 
Month {<SPAN 
style="mso-tab-count: 3">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>// Any access mod -- SAME class, default/pub – own 
class<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>NOV, <SPAN class=GramE>DEC(</SPAN>11), JAN, FEB;<SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp; </SPAN>//<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>Must end in semicolon if more than just 
declarations<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>Month(</SPAN>){}<SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>//<SPAN style="mso-spacerun: yes">&nbsp; </SPAN>No-<SPAN 
class=SpellE>arg</SPAN> constructor only auto-created by JVM<SPAN 
style="mso-tab-count: 1">&nbsp; </SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>Month(</SPAN>int index) {<SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>//<SPAN style="mso-spacerun: yes">&nbsp; </SPAN>if no other constructor 
provided – just like classes<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=SpellE>this.index</SPAN> = index;<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>}<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>int</SPAN> index;<SPAN 
style="mso-tab-count: 3">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>// Initialized automatically, can have any access modifier<SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">}; <SPAN 
style="mso-tab-count: 4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>// <SPAN class=GramE>This</SPAN> semicolon is 
optional<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN class=GramE><SPAN 
style="FONT-SIZE: 9pt">for</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> (Month 
<SPAN class=SpellE>month</SPAN>: <SPAN class=SpellE>Month.values</SPAN>()) 
{<SPAN style="mso-tab-count: 1">&nbsp;&nbsp; </SPAN>//notice values() 
method<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=SpellE><SPAN 
class=GramE>System.out.println</SPAN></SPAN><SPAN class=GramE>(</SPAN>"Day = " + 
month);<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">}<SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">Month <SPAN 
class=SpellE>month</SPAN> = <SPAN class=SpellE>Month.DEC</SPAN>;<SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN class=GramE><SPAN 
style="FONT-SIZE: 9pt">switch</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> (month) 
{<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE><B 
style="mso-bidi-font-weight: normal">case</B></SPAN><B 
style="mso-bidi-font-weight: normal"> DEC</B>: <SPAN 
class=SpellE>System.out.printf</SPAN>("%s %d %<SPAN 
class=SpellE>b","November</SPAN>", 264, true); <SPAN 
style="mso-tab-count: 1">&nbsp; </SPAN>//<B 
style="mso-bidi-font-weight: normal">CAN’T</B> use <SPAN 
class=SpellE>Month.DEC</SPAN> in case – won’t compile<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt">}<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><U><SPAN style="FONT-SIZE: 9pt">Really 
Complex<o:p></o:p></SPAN></U></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=SpellE><SPAN class=GramE>enum</SPAN></SPAN> Month 
{<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>NOV(</SPAN>"November", 11), <SPAN 
style="mso-tab-count: 3">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>// Notice various constructor formats that all compile and 
run<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>DEC(</SPAN>"December"), <o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>JAN {int <SPAN class=SpellE><SPAN class=GramE>getIndex</SPAN></SPAN><SPAN 
class=GramE>(</SPAN>){return 55;}}, <SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>// Notice <SPAN class=SpellE>overriden</SPAN> method here.<SPAN 
style="mso-spacerun: yes">&nbsp;&nbsp; </SPAN>CAN’T be new method – doesn’t 
compile<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>FEB(</SPAN>),<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>MAR;<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>Month(</SPAN>){}<SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>Month(</SPAN>String name, int index) 
{<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 3">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=SpellE>this.index</SPAN> = index;<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>}<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>Month(</SPAN>String name) {<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 3">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=SpellE>this.name</SPAN> = name;<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>}<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>protected</SPAN> int index;<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>String name;<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>int</SPAN> <SPAN class=SpellE>getIndex</SPAN>(){<SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>return</SPAN> <SPAN 
class=SpellE>this.index</SPAN>;<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>}<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>String <SPAN class=SpellE><SPAN class=GramE>getName</SPAN></SPAN><SPAN 
class=GramE>(</SPAN>){<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 3">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN><SPAN class=GramE>return</SPAN> <SPAN 
class=SpellE>this.name</SPAN>;<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 2">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>}<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>};<o:p></o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt"><o:p><SPAN 
style="TEXT-DECORATION: none">&nbsp;</SPAN></o:p></SPAN></U></B></P><B 
style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: 'Times New Roman'; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA"><BR 
style="PAGE-BREAK-BEFORE: always" clear=all></SPAN></U></B>
<P class=MsoNormal><SPAN class=SpellE><B 
style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Gotchas</SPAN></U></B></SPAN><B 
style="mso-bidi-font-weight: normal"><U><SPAN style="FONT-SIZE: 9pt"> (very 
tricky stuff)<o:p></o:p></SPAN></U></B></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Watch for faulty 
method returns, either returning types different than declared type or failing 
to return something, or returning something when void is declared, or not 
returning something if a return type was specified.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Watch for methods 
parading as constructors – constructors do not have return 
values!<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">If there is a method 
call to methods with the same name and with (String[] <SPAN 
class=SpellE>args</SPAN>) and (String… <SPAN class=SpellE>args</SPAN>), the code 
won’t compile b/c it won’t know which method to call<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Remember that after 
<SPAN class=SpellE>threadName.start</SPAN>() is declared, the thread my not 
enter the running state until all the code after it has been 
executed<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">The class has a 
lock, and each object has a lock, and notify() and <SPAN 
class=SpellE>notifyAll</SPAN>() only notify threads waiting for the SAME 
LOCK<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Static methods can’t 
override non-static methods and vice-versa – will not 
compile<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Watch out for 
statements that the compiler knows will never be reached (like after throwing an 
exception) – this code will not compile<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">new Boolean(“<SPAN 
class=SpellE>TRue</SPAN>”) results in true, new Boolean(“<SPAN 
class=SpellE>AnythingOtherThanCaseInsensitiveTrue</SPAN>”) is false, <SPAN 
class=SpellE>boolean</SPAN> x = true or false (<SPAN class=SpellE>boolean</SPAN> 
x=True or <SPAN class=SpellE>boolean</SPAN> x=TRUE will not 
compile)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">in <SPAN 
class=SpellE>System.out.format/printf</SPAN>(“%b”, <SPAN 
class=SpellE>varX</SPAN>) will print true if <SPAN class=SpellE>varX</SPAN> has 
any value<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">If Subclass is in a 
different package than <SPAN class=SpellE>Superclass</SPAN>, any protected 
variables in <SPAN class=SpellE>Superclass</SPAN> can only be reached from the 
main(0 in Subclass using an object reference to Subclass, not <SPAN 
class=SpellE>Superclass</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">When wait() and 
notify() methods are called from non-<SPAN class=SpellE>sychronized</SPAN> 
context, code will compile, but <SPAN 
class=SpellE>IllegalMonitorStateException</SPAN> will be thrown at 
runtime<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN class=SpellE><SPAN 
style="FONT-SIZE: 9pt">HashMap</SPAN></SPAN><SPAN style="FONT-SIZE: 9pt"> and 
<SPAN class=SpellE>LinkedHashMap</SPAN> can have 1 null key and multiple null 
values, but <SPAN class=SpellE>TreeMap</SPAN> can’t have any null keys (can have 
null values), and <SPAN class=SpellE>Hashtable</SPAN> can’t have any null keys 
or values (will result in <SPAN 
class=SpellE>NullPointerException</SPAN>)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Use of <SPAN 
class=SpellE><SPAN class=GramE>collectionType.toArray</SPAN></SPAN><SPAN 
class=GramE>(</SPAN>) and trying to use as array as specific types, without 
casting, when <SPAN class=SpellE>toArray</SPAN>() returns 
Objects.<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Static member 
variables are automatically initialized, final member variables must initialized 
by the time the constructor finishes, and static final member variables must be 
assigned at time of declaration or in a static initialization block.<SPAN 
style="mso-spacerun: yes">&nbsp; </SPAN>Breaking these rules results in failed 
compilation<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Classes can have 
multiple static initialization blocks and instance initialization blocks, which 
I think run in the order listed<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Can’t assume from 
listed code that a property value hasn’t already been set for use of <SPAN 
class=SpellE>System.getProperty</SPAN>(<SPAN class=SpellE>stringKey</SPAN>, 
<SPAN class=SpellE>stringDefaultValue</SPAN>), so can’t tell if property will be 
set to <SPAN class=SpellE>stringDefaultValue</SPAN> or not<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Watch out for trying 
to use elements of raw type (non-generic) collections without 
casting<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Watch out for static 
methods trying to make a reference to “this”<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Illegal to try to 
return literal 1.2 when return type is a float (the literal 1.2 is a 
double)<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Any methods 
implemented from an interface MUST be public since an interface’s methods are 
always public<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l11 level1 lfo5; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Get suspicious when 
you see the protected access modifier – they are probably going to try to 
illegally access it from outside the package (you can only <SPAN 
class=SpellE>acces</SPAN> it through inheritance, not through an instantiation 
of the object with the protected member<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Exam Tips</SPAN></U></B><SPAN 
style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l7 level1 lfo12; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">After finishing, go 
back and check every question for:<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>--calling non-static methods or using non-static variables in 
main<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>--for any Thread question, all <SPAN class=GramE>wait(</SPAN>), sleep(), 
and join() methods handle the <SPAN 
class=SpellE>InterruptedException</SPAN><o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><SPAN 
style="mso-tab-count: 1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN>--modifying strings but not having a reference to new modified 
string<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l7 level1 lfo12; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">Get suspicious when 
there is a mix of raw type collections and generic type 
collections<o:p></o:p></SPAN></P>
<P class=MsoNormal 
style="MARGIN-LEFT: 0.15in; TEXT-INDENT: -0.15in; mso-list: l7 level1 lfo12; tab-stops: list .15in"><![if !supportLists]><SPAN 
style="FONT-SIZE: 9pt; FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol"><SPAN 
style="mso-list: Ignore">·<SPAN 
style="FONT: 7pt 'Times New Roman'">&nbsp;&nbsp;&nbsp;&nbsp; 
</SPAN></SPAN></SPAN><![endif]><SPAN style="FONT-SIZE: 9pt">If question code 
contains packages and imports, watch out for probable errors using 
these.<o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P>
<P class=MsoNormal><B style="mso-bidi-font-weight: normal"><U><SPAN 
style="FONT-SIZE: 9pt">Random notes</SPAN></U></B><SPAN 
style="FONT-SIZE: 9pt"><o:p></o:p></SPAN></P>
<P class=MsoNormal><SPAN 
style="FONT-SIZE: 9pt"><o:p>&nbsp;</o:p></SPAN></P></DIV></BODY></HTML>
