\par }\pard\plain \s3\li360\sb120\sa60\sl-480\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel2\adjustright \f4\fs44\lang1024\cgrid {{\*\bkmkstart _Toc451776511}An extended canonical form{\*\bkmkend _Toc451776511}
\par }\pard\plain \s2\fi-810\li720\sb120\sa120\sl-640\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel1\adjustright \f4\fs60\lang1024\cgrid {{\*\bkmkstart _Toc451776512}Dynamic aggregation{\*\bkmkend _Toc451776512}
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The examples we\rquote ve seen so far are illustrative, but fairly simple. It\rquote s useful to see
 an example that has more complexity so you can see that the STL will work in all situations.
\par [[ Add a factory method that takes a vector of string]]
\par The class that will be created as the example will be reasonably complex: it\rquote s a bicycle which can have a choice of parts. In addition, you can change the parts during the lifetime of a }{\b Bicycle}{
 object; this includes the ability to add new parts or to upgrade from standard-quality parts to \ldblquote fancy\rdblquote  parts. The }{\b BicyclePart}{ class is a base class with many different types, and the }{\b Bicycle}{ class contains a }{\b 
vector<BicyclePart*>}{ to hold the various combination of parts that may be attached to a }{\b Bicycle}{:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: CXX:Bicycle.h
\par // Complex class involving dynamic aggregation
\par #ifndef BICYCLE_H
\par #define BICYCLE_H
\par #include <vector>
\par #include <string>
\par #include <iostream>
\par #include <typeinfo>
\par 
\par class LeakChecker \{
\par   int count;
\par public:
\par   LeakChecker() : count(0) \{\}
\par   void print() \{
\par     std::cout << count << std::endl; 
\par   \}
\par   ~LeakChecker() \{ print(); \}
\par   void operator++(int) \{ count++; \}
\par   void operator--(int) \{ count--; \}
\par \};
\par 
\par class BicyclePart \{
\par   static LeakChecker lc;
\par public:
\par   BicyclePart() \{ lc++; \}
\par   virtual BicyclePart* clone() = 0;
\par   virtual ~BicyclePart() \{ lc--; \}
\par   friend std::ostream& 
\par   operator<<(std::ostream& os, BicyclePart* bp) \{
\par     return os << typeid(*bp).name();
\par   \}
\par   friend class Bicycle;
\par \};
\par 
\par enum BPart \{
\par   Frame, Wheel, Seat, HandleBar, 
\par   Sprocket, Deraileur,
\par \};
\par 
\par template<BPart id> 
\par class Part : public BicyclePart \{
\par public:
\par   BicyclePart* clone() \{ return new Part<id>; \}
\par \};
\par 
\par class Bicycle \{
\par public:
\par   typedef std::vector<BicyclePart*> VBP;
\par   Bicycle();
\par   Bicycle(const Bicycle& old);
\par   Bicycle& operator=(const Bicycle& old);
\par   // [Other operators as needed go here:]
\par   // [...]
\par   // [...]
\par   ~Bicycle() \{ purge(); \}
\par   // So you can change parts on a bike (but be 
\par   // careful: you must clean up any objects you
\par   // remove from the bicycle!)
\par   VBP& bikeParts() \{ return parts; \}
\par   friend std::ostream& 
\par   operator<<(std::ostream& os, Bicycle* b);
\par   static void print(std::vector<Bicycle*>& vb, 
\par     std::ostream& os = std::cout);
\par private:
\par   static int counter;
\par   int id;
\par   VBP parts;
\par   void purge();
\par \};
\par 
\par // Both the Bicycle and the generator should 
\par // provide more variety than this. But this gives
\par // you the idea.
\par struct BicycleGenerator \{
\par   Bicycle* operator()() \{
\par     return new Bicycle();
\par   \}
\par \}; 
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {#endif // BICYCLE_H ///:~
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The }{\b operator<<}{ for }{\b ostream}{ and }{\b Bicycle}{ moves through and calls the }{\b operator<<}{ for each }{\b BicyclePart}{
, and that prints out the class name of the part so you can see what a }{\b Bicycle}{ contains. The }{\b BicyclePart::clone(\~)}{ member function is necessary in the copy-constructor of }{\b Bicycle}{, since it just has a }{\b vector<BicyclePart*>}{
 and wouldn\rquote t otherwise know how to copy the }{\b BicyclePart}{s correctly. The cloning process, of course, will be more involved when there are data members in a }{\b BicyclePart}{.
\par }{\b BicyclePart::partcount}{ is used to keep track of the number of parts created and destroyed (so you can detect memory leaks). It is incremented every time a new }{\b BicyclePart}{ is created and decremented when one is destroyed; also, when }{\b 
partcount}{ goes to zero this is reported and if it goes below zero there will be an }{\b assert(\~)}{ failure.
\par If you want to change }{\b BicyclePart}{s on a }{\b Bicycle}{, you just call }{\b Bicycle::bikeParts(\~)}{ to get the }{\b vector<BicyclePart*>}{ which you can then modify. But whenever you remove a part from a }{\b Bicycle}{, you must call }{\b delete}{
 for that pointer, otherwise it won\rquote t get cleaned up.
\par Here\rquote s the implementation:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: CXX:Bicycle.cpp \{O\}
\par // Bicycle implementation
\par #include "Bicycle.h"
\par #include <map>
\par #include <algorithm>
\par #include <cassert>
\par using namespace std;
\par 
\par // Static member definitions:
\par LeakChecker BicyclePart::lc;
\par int Bicycle::counter = 0;
\par 
\par Bicycle::Bicycle() : id(counter++) \{
\par   BicyclePart *bp[] = \{
\par     new Part<Frame>, 
\par     new Part<Wheel>, new Part<Wheel>, 
\par     new Part<Seat>, new Part<HandleBar>,
\par     new Part<Sprocket>,  new Part<Deraileur>,
\par   \};
\par   const int bplen = sizeof bp / sizeof *bp;
\par   parts = VBP(bp, bp + bplen);
\par \}
\par 
\par Bicycle::Bicycle(const Bicycle& old) 
\par   : parts(old.parts.begin(), old.parts.end()) \{
\par   for(int i = 0; i < parts.size(); i++)
\par     parts[i] = parts[i]->clone();
\par \}
\par 
\par Bicycle& Bicycle::operator=(const Bicycle& old) \{
\par   purge(); // Remove old lvalues
\par   parts.resize(old.parts.size());
\par   copy(old.parts.begin(), 
\par     old.parts.end(), parts.begin());
\par   for(int i = 0; i < parts.size(); i++)
\par     parts[i] = parts[i]->clone();
\par   return *this;
\par \}
\par 
\par void Bicycle::purge() \{
\par   for(VBP::iterator it = parts.begin();
\par     it != parts.end(); it++) \{
\par       delete *it;
\par       *it = 0; // Prevent multiple deletes
\par   \}
\par \}
\par 
\par ostream& operator<<(ostream& os, Bicycle* b) \{
\par   copy(b->parts.begin(), b->parts.end(),
\par     ostream_iterator<BicyclePart*>(os, "\\n"));
\par   os << "--------" << endl;
\par   return os;
\par \}
\par 
\par void Bicycle::print(vector<Bicycle*>& vb, 
\par   ostream& os) \{
\par   copy(vb.begin(), vb.end(),
\par     ostream_iterator<Bicycle*>(os, "\\n"));
\par   cout << "--------" << endl;
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {Here\rquote s a test:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: CXX:BikeTest.cpp
\par //\{L\} Bicycle
\par #include "Bicycle.h"
\par #include <algorithm>
\par using namespace std;
\par 
\par int main() \{
\par   vector<Bicycle*> bikes;
\par   BicycleGenerator bg;
\par   generate_n(back_inserter(bikes), 12, bg);
\par   Bicycle::print(bikes);
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {
\par }\pard\plain \s2\fi-810\li720\sb120\sa120\sl-640\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel1\adjustright \f4\fs60\lang1024\cgrid {{\*\bkmkstart _Toc451776513}Reference counting{\*\bkmkend _Toc451776513}
\par {\*\bkmkstart _Toc451776514}Reference-counted class hierarchies{\*\bkmkend _Toc451776514}
