The first examples concern the generation of programs that, coincidentally, fit the format used in this book. This provides a little extra speed and consistency when developing code. The first program creates a file to hold }{\b main(\~)}{
 (assuming it takes no command-line arguments and uses the iostream library):
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C18:Makemain.cpp
\par // Create a shell main() file
\par #include "../require.h"
\par #include <fstream>
\par #include <strstream>
\par #include <cstring>
\par #include <cctype>
\par using namespace std;
\par 
\par int main(int argc, char* argv[]) \{
\par   requireArgs(argc, 1);
\par   ofstream mainfile(argv[1]);
\par   assure(mainfile, argv[1]);
\par   istrstream name(argv[1]);
\par   ostrstream CAPname;
\par   char c;
\par   while(name.get(c))
\par     CAPname << char(toupper(c));
\par   CAPname << ends;
\par   mainfile << "//" << ": " << CAPname.rdbuf()
\par     << " -- " << endl
