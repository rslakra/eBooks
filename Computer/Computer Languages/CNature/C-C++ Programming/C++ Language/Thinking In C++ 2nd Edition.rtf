\par     << endl
\par     << "SCircle::quantity() = "
\par     << SCircle::quantity() << endl
\par     << "SEllipse::quantity() = "
\par     << SEllipse::quantity() << endl
\par     << "SRectangle::quantity() = "
\par     << SRectangle::quantity() << endl
\par     << "Shape::quantity() = "
\par     << Shape::quantity() << endl;
