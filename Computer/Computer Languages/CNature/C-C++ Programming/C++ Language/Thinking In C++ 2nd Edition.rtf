\par   ifstream in("Fillvector.cpp");
\par   string word;
\par   while(in >> word)
\par     words.push_back(word); 
\par   for(int i = 0; i < words.size(); i++)
\par     cout << words[i] << endl;
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 \adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
