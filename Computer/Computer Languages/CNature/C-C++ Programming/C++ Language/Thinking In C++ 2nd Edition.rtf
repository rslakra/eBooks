\par }\pard\plain \s3\li360\sb120\sa60\sl-480\slmult0\keep\keepn\widctlpar\outlinelevel2\adjustright \f4\fs44\lang1024\cgrid {{\*\bkmkstart _Toc451776041}Common pitfalls when using operators{\*\bkmkend _Toc451776041}}{\pard\plain 
\s3\li360\sb120\sa60\sl-480\slmult0\keep\keepn\widctlpar\outlinelevel2\adjustright \v\f4\fs44\lang1024\cgrid {\xe {common pitfalls when using operators}}}{\pard\plain \s3\li360\sb120\sa60\sl-480\slmult0\keep\keepn\widctlpar\outlinelevel2\adjustright 
\v\f4\fs44\lang1024\cgrid {\xe {operator\: common pitfalls}}}{
