\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C15:Sizes.cpp
\par // Object sizes vs. virtual funcs
\par #include <iostream>
\par using namespace std;
\par 
\par class NoVirtual \{
\par   int a;
\par public:
\par   void x() const \{\}
\par   int i() const \{ return 1; \}
\par \};
\par 
\par class OneVirtual \{
\par   int a;
\par public:
\par   virtual void x() const \{\}
\par   int i() const \{ return 1; \}
\par \};
\par 
\par class TwoVirtuals \{
\par   int a;
\par public:
\par   virtual void x() const \{\}
\par   virtual int i() const \{ return 1; \}
\par \};
\par 
\par int main() \{
\par   cout << "int: " << sizeof(int) << endl;
\par   cout << "NoVirtual: "
\par        << sizeof(NoVirtual) << endl;
\par   cout << "void* : " << sizeof(void*) << endl;
\par   cout << "OneVirtual: "
\par        << sizeof(OneVirtual) << endl;
\par   cout << "TwoVirtuals: "
\par        << sizeof(TwoVirtuals) << endl;
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
