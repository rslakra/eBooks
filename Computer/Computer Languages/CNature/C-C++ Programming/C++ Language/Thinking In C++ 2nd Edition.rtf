\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C13:Malclass.cpp
\par // Malloc with class objects
\par // What you'd have to do if not for "new"
\par #include "../require.h"
