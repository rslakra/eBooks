\par The reason }{\b TrashBin}{ must be a template is so it can automatically generate the }{\b grab(\~)}{ function. A further templatization will allow the }{\b vector}{s to hold specific types.
\par That said, we can look at the whole program to see how all this is implemented. 
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 \adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C25:Recycle4.cpp
\par //\{L\} TrashPrototypeInit
\par //\{L\} fillBin Trash TrashStatics
\par // Adding TrashBins and TrashSorters
\par #include "Trash.h"
\par #include "Aluminum.h"
\par #include "Paper.h"
\par #include "Glass.h"
\par #include "Cardboard.h"
\par #include "fillBin.h"
\par #include "sumValue.h"
\par #include "../purge.h"
\par #include <fstream>
\par #include <vector>
\par using namespace std;
\par ofstream out("Recycle4.out");
\par 
\par class TBin : public vector<Trash*> \{
\par public:
\par   virtual bool grab(Trash*) = 0;
\par \};
\par 
\par template<class TrashType>
\par class TrashBin : public TBin \{
\par public:
\par   bool grab(Trash* t) \{
\par     TrashType* tp = dynamic_cast<TrashType*>(t);
\par     if(!tp) return false; // Not grabbed
\par     push_back(tp);
\par     return true; // Object grabbed
\par   \}
\par \};
\par 
\par class TrashSorter : public vector<TBin*> \{
\par public:
\par   bool sort(Trash* t) \{
\par     for(iterator it = begin(); it != end(); it++)
\par       if((*it)->grab(t))
\par         return true;
\par     return false;
\par   \}
\par   void sortBin(vector<Trash*>& bin) \{
\par     vector<Trash*>::iterator it;
\par     for(it = bin.begin(); it != bin.end(); it++)
\par       if(!sort(*it))
\par         cerr << "bin not found" << endl;
\par   \}
\par   ~TrashSorter() \{ purge(*this); \}
\par \};
\par 
\par int main() \{
\par   vector<Trash*> bin;
\par   // Fill up the Trash bin:
\par   fillBin("Trash.dat", bin);
\par   TrashSorter tbins;
\par   tbins.push_back(new TrashBin<Aluminum>());
\par   tbins.push_back(new TrashBin<Paper>());
\par   tbins.push_back(new TrashBin<Glass>());
\par   tbins.push_back(new TrashBin<Cardboard>());
\par   tbins.sortBin(bin);
\par   for(TrashSorter::iterator it = tbins.begin(); 
\par     it != tbins.end(); it++)
\par     sumValue(**it);
\par   sumValue(bin);
\par   purge(bin);
