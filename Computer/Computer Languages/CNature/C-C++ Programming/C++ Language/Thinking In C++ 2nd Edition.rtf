\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {maintaining class library source}}}{\pard\plain 
\sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {class\: maintaining library source}}}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {library\:
 maintaining class source}}}{The second example performs a more complex and useful task. Generally, when you create a class you think in library terms, and make a header file }{\b Name.h }{
for the class declaration and a file where the member functions are implemented, called }{\b Name.cpp}{\caps . T}{hese files have certain requirements: a particular coding standard (the program 
shown here will use the coding format for this book), and in the header file the declarations are generally surrounded by some preprocessor statements to prevent multiple declarations of classes. (Multiple declarations confuse the compiler \endash 
 it doesn\rquote t know which one you want to use. They could be different, so it throws up its hands and gives an error message.)
\par This example allows you to create a new header-implementation pair of files, or to modify an existing pair. If the files already exist, it checks and potentially modifies the files, but if they don\rquote t exist, it creates them using the proper format.

\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C18:Cppcheck.cpp
\par // Configures .h & .cpp files
\par // To conform to style standard.
\par // Tests existing files for conformance
\par #include "../require.h"
\par #include <fstream>
\par #include <strstream>
\par #include <cstring>
\par #include <cctype>
\par using namespace std;
\par 
\par int main(int argc, char* argv[]) \{
\par   const int sz = 40;  // Buffer sizes
\par   const int bsz = 100;
\par   requireArgs(argc, 1); // File set name
\par   enum bufs \{ base, header, implement,
\par     Hline1, guard1, guard2, guard3,
\par     CPPline1, include, bufnum \};
\par   char b[bufnum][sz];
\par   ostrstream osarray[] = \{
\par     ostrstream(b[base], sz),
\par     ostrstream(b[header], sz),
\par     ostrstream(b[implement], sz),
\par     ostrstream(b[Hline1], sz),
\par     ostrstream(b[guard1], sz),
\par     ostrstream(b[guard2], sz),
\par     ostrstream(b[guard3], sz),
\par     ostrstream(b[CPPline1], sz),
\par     ostrstream(b[include], sz),
\par   \};
\par   osarray[base] << argv[1] << ends;
\par   // Find any '.' in the string using the
\par   // Standard C library function strchr():
\par   char* period = strchr(b[base], '.');
\par   if(period) *period = 0; // Strip extension
\par   // Force to upper case:
\par   for(int i = 0; b[base][i]; i++)
\par     b[base][i] = toupper(b[base][i]);
\par   // Create file names and internal lines:
\par   osarray[header] << b[base] << ".h" << ends;
\par   osarray[implement] << b[base] << ".cpp" << ends;
\par   osarray[Hline1] << "//" << ": " << b[header]
\par     << " -- " << ends;
\par   osarray[guard1] << "#ifndef " << b[base]
\par                   << "_H" << ends;
\par   osarray[guard2] << "#define " << b[base]
\par                   << "_H" << ends;
\par   osarray[guard3] << "#endif // " << b[base]
\par                   << "_H" << ends;
\par   osarray[CPPline1] << "//" << ": "
\par                     << b[implement]
\par                     << " -- " << ends;
\par   osarray[include] << "#include \\""
\par                    << b[header] << "\\"" <<ends;
\par   // First, try to open existing files:
\par   ifstream existh(b[header]),
\par            existcpp(b[implement]);
\par   if(!existh) \{ // Doesn't exist; create it
\par     ofstream newheader(b[header]);
\par     assure(newheader, b[header]);
\par     newheader << b[Hline1] << endl
\par       << b[guard1] << endl
\par       << b[guard2] << endl << endl
\par       << b[guard3] << endl;
\par   \}
\par   if(!existcpp) \{ // Create cpp file
\par     ofstream newcpp(b[implement]);
\par     assure(newcpp, b[implement]);
\par     newcpp << b[CPPline1] << endl
\par       << b[include] << endl;
\par   \}
\par   if(existh) \{ // Already exists; verify it
\par     strstream hfile; // Write & read
\par     ostrstream newheader; // Write
\par     hfile << existh.rdbuf() << ends;
\par     // Check that first line conforms:
\par     char buf[bsz];
\par     if(hfile.getline(buf, bsz)) \{
\par       if(!strstr(buf, "//" ":") ||
\par          !strstr(buf, b[header]))
\par         newheader << b[Hline1] << endl;
\par     \}
\par     // Ensure guard lines are in header:
\par     if(!strstr(hfile.str(), b[guard1]) ||
\par        !strstr(hfile.str(), b[guard2]) ||
\par        !strstr(hfile.str(), b[guard3])) \{
\par        newheader << b[guard1] << endl
\par          << b[guard2] << endl
\par          << buf
\par          << hfile.rdbuf() << endl
\par          << b[guard3] << endl << ends;
\par     \} else
\par       newheader << buf
\par         << hfile.rdbuf() << ends;
\par     // If there were changes, overwrite file:
\par     if(strcmp(hfile.str(),newheader.str())!=0)\{
\par       existh.close();
\par       ofstream newH(b[header]);
\par       assure(newH, b[header]);
\par       newH << "//@//" << endl // Change marker
\par         << newheader.rdbuf();
\par     \}
\par     delete hfile.str();
\par     delete newheader.str();
\par   \}
\par   if(existcpp) \{ // Already exists; verify it
\par     strstream cppfile;
\par     ostrstream newcpp;
\par     cppfile << existcpp.rdbuf() << ends;
\par     char buf[bsz];
\par     // Check that first line conforms:
\par     if(cppfile.getline(buf, bsz))
\par       if(!strstr(buf, "//" ":") ||
\par          !strstr(buf, b[implement]))
\par         newcpp << b[CPPline1] << endl;
\par     // Ensure header is included:
\par     if(!strstr(cppfile.str(), b[include]))
\par       newcpp << b[include] << endl;
\par     // Put in the rest of the file:
\par     newcpp << buf << endl; // First line read
\par     newcpp << cppfile.rdbuf() << ends;
\par     // If there were changes, overwrite file:
\par     if(strcmp(cppfile.str(),newcpp.str())!=0)\{
\par       existcpp.close();
\par       ofstream newCPP(b[implement]);
\par       assure(newCPP, b[implement]);
\par       newCPP << "//@//" << endl // Change marker
\par         << newcpp.rdbuf();
\par     \}
\par     delete cppfile.str();
\par     delete newcpp.str();
\par   \}
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {This example requires a lot of string formatting in many different buffers. Rather than creating a lot of individually named buffers and }{\b ostrstream}{ }
{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {ostrstream}}}{objects, a single set of names is created in the }{\b enum}{ }{\b bufs}{. Then two arra
ys are created: an array of character buffers and an array of }{\b ostrstream}{ objects built from those character buffers. Note that in the definition for the two-dimensional array of }{\b char}{ buffers }{\b b}{, the number of }{\b char}{
 arrays is determined by }{\b bufnum}{, the last enumerator in }{\b bufs}{. When you create an enumeration}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {enumeration}}}{
, the compiler assigns integral values to all the }{\b enum}{ labels starting at zero, so the sole purpose of }{\b bufnum}{ is to be a counter for the number of enumerators in }{\b buf}{. The length of each string in }{\b b}{ is }{\b sz}{.
\par The names in the enumeration are }{\b base}{, the capitalized base file name without extension; }{\b header}{, the header file name; }{\b implement}{, the implementation file (}{\b cpp}{) name; }{\b Hline1}{, the skeleton first line of the header file; }{
\b guard1}{, }{\b guard2}{, and }{\b guard3}{, the \ldblquote guard\rdblquote  lines in the header file (to prevent multiple inclusion); }{\b CPPline1}{, the skeleton first line of the }{\b cpp}{ file; and }{\b include}{, the line in the }{\b cpp}{
 file that includes the header file.
\par }{\b osarray}{ is an array of }{\b ostrstream}{ objects created using aggregate initialization and automatic counting. Of course, this is the form of the }{\b ostrstream}{
 constructor that takes two arguments (the buffer address and buffer size), so the constructor calls must be formed accordingly inside the aggregate initializer list. Using the }{\b bufs}{ enumerators, the appropriate array element of }{\b b}{
 is tied to the corresponding }{\b osarray}{ object. Once the array is created, the objects in the array can be selected using the enumerators, and the effect is to fill the corresponding }{\b b}{ element. Yo
u can see how each string is built in the lines following the }{\b ostrstream}{ array definition.
\par Once the strings have been created, the program attempts to open existing versions of both the header and }{\b cpp}{ file as }{\b ifstream}{s. If you test the object using the operator \lquote }{\b !}{\rquote  and the file doesn\rquote 
t exist, the test will fail. If the header or implementation file doesn\rquote t exist, it is created using the appropriate lines of text built earlier.
\par If the files }{\i do}{ exist, then they are verified to ensure the proper format is followed. In both cases, a }{\b strstream}{ }{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {strstream}}}{
is created and the whole file is read in; then the first line is read and checked to make sure it follows the format by seeing if it contains both a \ldblquote }{\b //:}{\rdblquote  and the name of the file. This is accomplished with 
the Standard C library function }{\b strstr(\~)}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {strstr(\~)}}}{. If the first line doesn\rquote t conform, the one created earlier is inserted into an 
}{\b ostrstream}{ that has been created to hold the edited file.
\par In the header file, the whole file is searched (again using }{\b strstr(\~)}{) to ensure it contains the three \ldblquote guard\rdblquote 
 lines; if not, they are inserted. The implementation file is checked for the existence of the line that includes the header file (although the compiler effectively guarantees its existence).
\par In both cases, the original file (in its }{\b strstream}{) and the edited file (in the }{\b ostrstream}{) are compared to see if there are any changes. If there are, the existing file is closed, and a new }{\b ofstream}{
 object is created to overwrite it. The }{\b ostrstream}{ is output to the file after a special change marker is added at the beginning, so you can use a text search program to rapidly find any files that need reviewing to make additional changes.
\par }\pard\plain \s4\li720\sa120\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel3\adjustright \f4\fs32\lang1024\cgrid {Detecting compiler errors
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {All the code in this book is designed to compile as shown without errors}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }
\adjustright \v\fs20\cgrid {\xe {compiler error tests}}}{. Any line of code that should generate a compile-time error is commented out with the special comment sequence \ldblquote //!\rdblquote 
. The following program will remove these special comments and append a numbered comment to the line
, so that when you run your compiler it should generate error messages and you should see all the numbers appear when you compile all the files. It also appends the modified line to a special file so you can easily locate any lines that don\rquote 
t generate errors:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C18:Showerr.cpp
\par // Un-comment error generators
\par #include "../require.h"
\par #include <iostream>
\par #include <fstream>
\par #include <strstream>
\par #include <cctype>
\par #include <cstring>
\par using namespace std;
\par char* marker = "//!";
\par 
\par char* usage =
\par "usage: showerr filename chapnum\\n"
\par "where filename is a C++ source file\\n"
\par "and chapnum is the chapter name it's in.\\n"
\par "Finds lines commented with //! and removes\\n"
\par "comment, appending //(#) where # is unique\\n"
\par "across all files, so you can determine\\n"
\par "if your compiler finds the error.\\n"
\par "showerr /r\\n"
\par "resets the unique counter.";
\par 
\par // File containing error number counter:
\par char* errnum = "../errnum.txt";
\par // File containing error lines:
\par char* errfile = "../errlines.txt";
\par ofstream errlines(errfile,ios::app);
\par 
\par int main(int argc, char* argv[]) \{
\par   requireArgs(argc, 2, usage);
\par   if(argv[1][0] == '/' || argv[1][0] == '-') \{
\par     // Allow for other switches:
\par     switch(argv[1][1]) \{
\par       case 'r': case 'R':
\par         cout << "reset counter" << endl;
\par         remove(errnum); // Delete files
\par         remove(errfile);
\par         return 0;
\par       default:
\par         cerr << usage << endl;
\par         return 1;
\par     \}
\par   \}
\par   char* chapter = argv[2];
\par   strstream edited; // Edited file
\par   int counter = 0;
\par   \{
\par     ifstream infile(argv[1]);
\par     assure(infile, argv[1]);
\par     ifstream count(errnum);
\par     assure(count, errnum);
\par     if(count) count >> counter;
\par     int linecount = 0;
\par     const int sz = 255;
\par     char buf[sz];
\par     while(infile.getline(buf, sz)) \{
\par       linecount++;
\par       // Eat white space:
\par       int i = 0;
\par       while(isspace(buf[i]))
\par         i++;
\par       // Find marker at start of line:
\par       if(strstr(&buf[i], marker) == &buf[i]) \{
\par         // Erase marker:
\par         memset(&buf[i], ' ', strlen(marker));
\par         // Append counter & error info:
\par         ostrstream out(buf, sz, ios::ate);
\par         out << "//(" << ++counter << ") "
\par             << "Chapter " << chapter
\par             << " File: " << argv[1]
\par             << " Line " << linecount << endl
\par             << ends;
\par           edited << buf;
\par         errlines << buf; // Append error file
\par       \} else
\par         edited << buf << "\\n"; // Just copy
\par     \}
\par   \} // Closes files
\par   ofstream outfile(argv[1]); // Overwrites
\par   assure(outfile, argv[1]);
\par   outfile << edited.rdbuf();
\par   ofstream count(errnum); // Overwrites
\par   assure(count, errnum);
\par   count << counter; // Save new counter
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The marker can be replaced with one of your choice.
\par Each file is read a line at a time, and each line is searched for the marker appearing at the head of the line; the line is modified and put into the error line list and into the }{\b strstream}{ }{\b edited}{
. When the whole file is processed, it is closed (by reaching the end of a scope), reopened as an output file and }{\b edited}{ is poured into the file. Also notice the counter is saved in an external 
file, so the next time this program is invoked it continues to sequence the counter.
\par }\pard\plain \s3\li360\sb120\sa60\sl-480\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel2\adjustright \f4\fs44\lang1024\cgrid {{\*\bkmkstart _Toc312373899}{\*\bkmkstart _Toc451776345}A simple datalogger
{\*\bkmkend _Toc312373899}{\*\bkmkend _Toc451776345}
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {datalogger}}}{
This example shows an approach you might take to log data to disk and later retrieve it for processing. The example is meant to produce a temperature-depth profile of the ocean at various points. To hold the data, a class is used:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C18:DataLogger.h
\par // Datalogger record layout
\par #ifndef DATALOG_H
\par #define DATALOG_H
\par #include <ctime>
\par #include <iostream>
\par 
\par class DataPoint \{
\par   std::tm time; // Time & day
\par   static const int bsz = 10;
\par   // Ascii degrees (*) minutes (') seconds ("):
\par   char latitude[bsz], longitude[bsz];
\par   double depth, temperature;
\par public:
\par   std::tm getTime();
\par   void setTime(std::tm t);
\par   const char* getLatitude();
\par   void setLatitude(const char* l);
\par   const char* getLongitude();
\par   void setLongitude(const char* l);
\par   double getDepth();
\par   void setDepth(double d);
\par   double getTemperature();
\par   void setTemperature(double t);
\par   void print(std::ostream& os);
\par \};
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {#endif // DATALOG_H ///:~
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The access functions provide controlled reading and writing to each of the data members. The }{\b print(\~)}{ function formats the }{\b DataPoint}{
 in a readable form onto an }{\b ostream}{ object (the argument to }{\b print(\~)}{). Here\rquote s the definition file:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C18:Datalog.cpp \{O\}
\par // Datapoint member functions
\par #include "DataLogger.h"
\par #include <iomanip>
\par #include <cstring>
\par using namespace std;
\par 
\par tm DataPoint::getTime() \{ return time; \}
\par 
\par void DataPoint::setTime(tm t) \{ time = t; \}
\par 
\par const char* DataPoint::getLatitude() \{
\par   return latitude;
\par \}
\par 
\par void DataPoint::setLatitude(const char* l) \{
\par   latitude[bsz - 1] = 0;
\par   strncpy(latitude, l, bsz - 1);
\par \}
\par 
\par const char* DataPoint::getLongitude() \{
\par   return longitude;
\par \}
\par 
\par void DataPoint::setLongitude(const char* l) \{
\par   longitude[bsz - 1] = 0;
\par   strncpy(longitude, l, bsz - 1);
\par \}
\par 
\par double DataPoint::getDepth() \{ return depth; \}
\par 
\par void DataPoint::setDepth(double d) \{ depth = d; \}
\par 
\par double DataPoint::getTemperature() \{
\par   return temperature;
\par \}
\par 
\par void DataPoint::setTemperature(double t) \{
\par   temperature = t;
\par \}
\par 
\par void DataPoint::print(ostream& os) \{
\par   os.setf(ios::fixed, ios::floatfield);
\par   os.precision(4);
\par   os.fill('0'); // Pad on left with '0'
\par   os << setw(2) << getTime().tm_mon << '\\\\'
\par      << setw(2) << getTime().tm_mday << '\\\\'
\par      << setw(2) << getTime().tm_year << ' '
\par      << setw(2) << getTime().tm_hour << ':'
\par      << setw(2) << getTime().tm_min << ':'
\par      << setw(2) << getTime().tm_sec;
\par   os.fill(' '); // Pad on left with ' '
\par   os << " Lat:" << setw(9) << getLatitude()
\par      << ", Long:" << setw(9) << getLongitude()
\par      << ", depth:" << setw(9) << getDepth()
\par      << ", temp:" << setw(9) << getTemperature()
\par      << endl;
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {In }{\b print(\~)}{, the call to }{\b setf(\~)}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {
iostreams\: setf(\~)}}}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {setf(\~), iostreams}}}{ causes the floating-point output to be fixed-precision, and }{\b precision(\~)}{\pard\plain 
\sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {iostreams\: precision(\~)}}}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {precision(\~)}}}{
 sets the number of decimal places to four.
\par The default is to right-justify the data within the field. The time information consists of two digits each for the hours, minutes and seconds, so the width is set to two with }{\b setw(\~)}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0
\pndec }\adjustright \v\fs20\cgrid {\xe {iostreams\: setw(\~)}}}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {setw(\~)}}}{
 in each case. (Remember that any changes to the field width affect only the next output operation, so }{\b setw(\~)}{ must be given for each output.) But first, to put a zero in the left position if the value is less than 10, the fill character }
{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {iostreams\: fill character}}}{is set to \lquote 0\rquote . Afterwards, it is set back to a space.
\par The latitude and longitude are zero-terminated character fields, which hold the information as degrees (here, \lquote *\rquote  denotes degrees), minutes (\lquote ), and seconds(\ldblquote 
). You can certainly devise a more efficient storage layout for latitude and longitude if you desire.
\par }\pard\plain \s4\li720\sa120\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel3\adjustright \f4\fs32\lang1024\cgrid {Generating test data
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {Here\rquote s a program that creates a file of test data in binary form (using }{\b write(\~)}{) and a second file in ASCII form using }{\b DataPoint::print(
\~)}{. You can also print it out to the screen but it\rquote s easier to inspect in file form.
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C18:Datagen.cpp
\par //\{L\} Datalog
\par // Test data generator
\par #include "DataLogger.h"
\par #include "../require.h"
\par #include <fstream>
\par #include <cstdlib>
\par #include <cstring>
\par using namespace std;
\par 
\par int main() \{
\par   ofstream data("data.txt");
\par   assure(data, "data.txt");
\par   ofstream bindata("data.bin", ios::binary);
\par   assure(bindata, "data.bin");
\par   time_t timer;
\par   // Seed random number generator:
\par   srand(time(&timer)); 
\par   for(int i = 0; i < 100; i++) \{
\par     DataPoint d;
\par     // Convert date/time to a structure:
\par     d.setTime(*localtime(&timer));
\par     timer += 55; // Reading each 55 seconds
\par     d.setLatitude("45*20'31\\"");
\par     d.setLongitude("22*34'18\\"");
\par     // Zero to 199 meters:
\par     double newdepth  = rand() % 200;
\par     double fraction = rand() % 100 + 1;
\par     newdepth += double(1) / fraction;
\par     d.setDepth(newdepth);
\par     double newtemp = 150 + rand()%200; // Kelvin
\par     fraction = rand() % 100 + 1;
\par     newtemp += (double)1 / fraction;
\par     d.setTemperature(newtemp);
\par     d.print(data);
\par     bindata.write((unsigned char*)&d,
\par                   sizeof(d));
\par   \}
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The file DATA.TXT is created in the ordinary way as an ASCII file, but DATA.BIN has the flag }{\b ios::binary}{
 to tell the constructor to set it up as a binary file.
\par The Standard C library function }{\b time(\~)}{, when called with a zero argument, returns the current time as a }{\b time_t}{ value, which is the number of seconds elapsed since 00:00:00 G
MT, January 1 1970 (the dawning of the age of Aquarius?). The current time is the most convenient way to seed the random number generator with the Standard C library function }{\b srand(\~)}{, as is done here.
\par Sometimes a more convenient way to store the time is as a }{\b tm}{ structure, which has all the elements of the time and date broken up into their constituent parts as follows:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {struct tm \{
\par   int tm_sec; // 0-59 seconds
\par   int tm_min; // 0-59 minutes
\par   int tm_hour; // 0-23 hours
\par   int tm_mday; // Day of month
\par   int tm_mon; // 1-12 months
\par   int tm_year; // Calendar year
\par   int tm_wday; // Sunday == 0, etc.
\par   int tm_yday; // 0-365 day of year
\par   int tm_isdst; // Daylight savings?
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\};
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
