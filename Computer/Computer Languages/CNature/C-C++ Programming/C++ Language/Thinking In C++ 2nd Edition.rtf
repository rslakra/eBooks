\par Tue Nov 16 18:15:49 1993
\par Latitude   Longitude  Depth     Temperature
\par -------------------------------------------
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {45*20'31"  22*34'18"  186.0172  269.0167    
