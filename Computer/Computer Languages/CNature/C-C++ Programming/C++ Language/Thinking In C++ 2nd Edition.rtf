\par This question is virtually eliminated if the object rather than a pointer resides in the list. Then it seems clear that when the list is destroyed, the objects it contains must also be destroyed. Here, the 
STL shines, as you can see when creating a container of }{\b string}{ objects. The following example stores each incoming line as a }{\b string}{ in a }{\b vector<string>}{:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 \adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C20:StringVector.cpp
\par // A vector of strings
\par #include "../require.h"
\par #include <string>
\par #include <vector>
\par #include <fstream>
\par #include <iostream>
\par #include <iterator>
\par #include <sstream>
\par using namespace std;
\par 
\par int main(int argc, char* argv[]) \{
\par   requireArgs(argc, 1);
\par   ifstream in(argv[1]);
\par   assure(in, argv[1]);
\par   vector<string> strings;
\par   string line;
\par   while(getline(in, line))
\par     strings.push_back(line);
\par   // Do something to the strings...
\par   int i = 1;
\par   vector<string>::iterator w;
\par   for(w = strings.begin();
\par       w != strings.end(); w++) \{
\par     ostringstream ss;
\par     ss << i++;
\par     *w = ss.str() + ": " + *w;
\par   \}
\par   // Now send them out:
\par   copy(strings.begin(), strings.end(),
\par     ostream_iterator<string>(cout, "\\n"));
\par   // Since they aren't pointers, string 
\par   // objects clean themselves up! 
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 \adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
\par }\pard\plain \s26\li360\widctlpar\adjustright \f6\fs6\lang1024\kerning18\cgrid {
