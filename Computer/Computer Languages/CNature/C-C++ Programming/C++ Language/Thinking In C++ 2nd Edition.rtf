\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The }{\b template}{ keyword te
lls the compiler that the following class definition will manipulate one or more unspecified types. At the time the object is defined, those types must be specified so the compiler can substitute them.
\par Here\rquote s a small example to demonstrate the syntax:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C16:Stemp.cpp
\par // Simple template example
\par #include "../require.h"
\par #include <iostream>
\par using namespace std;
\par 
\par template<class T>
\par class Array \{
\par   enum \{ size = 100 \};
\par   T A[size];
\par public:
\par   T& operator[](int index) \{
\par     require(index >= 0 && index < size);
\par     return A[index];
\par   \}
\par \};
\par 
\par int main() \{
\par   Array<int> ia;
\par   Array<float> fa;
\par   for(int i = 0; i < 20; i++) \{
\par     ia[i] = i * i;
\par     fa[i] = float(i) * 1.414;
\par   \}
