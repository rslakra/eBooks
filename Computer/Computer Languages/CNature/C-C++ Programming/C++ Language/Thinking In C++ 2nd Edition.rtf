\par #include "Myheader.h"
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\}
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {Most C++ compiler vendors handle the alternate linkage specifications inside their header files that work with both C and C++, so you don\rquote 
t have to worry about it.
\par The only alternate linkage specification strings that are standard are \ldblquote C\rdblquote  and \ldblquote C++\rdblquote  but implementations can support other languages using the same mechanism.
\par }\pard\plain \s2\fi-810\li720\sb120\sa120\sl-640\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel1\adjustright \f4\fs60\lang1024\cgrid {{\*\bkmkstart _Toc305593224}{\*\bkmkstart _Toc305628696}{\*\bkmkstart _Toc312373955
