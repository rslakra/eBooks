\par     \}
\par   \}
\par   void updateAscii() \{
\par     if(!aflag) \{
\par       updateLocal();
\par       std::strcpy(asciiRep,std::asctime(&local));
\par       aflag++;
\par     \}
\par   \}
\par public:
\par   Time() \{ mark(); \}
\par   void mark() \{
\par     lflag = aflag = 0;
\par     std::time(&t);
\par   \}
\par   const char* ascii() \{
\par     updateAscii();
\par     return asciiRep;
\par   \}
