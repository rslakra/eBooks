\par }\pard\plain \s15\li720\sa180\sl270\slmult0\widctlpar\adjustright \f4\fs28\cgrid {\cs23\fs16\up6 \chftn {\footnote \pard\plain \s34\li720\sa180\sl240\slmult0\widctlpar\adjustright \f4\fs18\kerning18\cgrid {\cs23\fs16\up6 \chftn }{
