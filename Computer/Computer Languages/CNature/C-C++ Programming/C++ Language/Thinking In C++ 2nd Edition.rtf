\par }\pard\plain \s4\li720\sa120\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel3\adjustright \f4\fs32\lang1024\cgrid {Temporary objects
