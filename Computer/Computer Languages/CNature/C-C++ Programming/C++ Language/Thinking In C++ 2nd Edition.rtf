\par // Early binding & virtuals
\par #include <iostream>
\par using namespace std;
\par 
\par class Base \{
\par public:
\par   virtual int f() const \{ return 1; \}
\par \};
\par 
\par class Derived : public Base \{
\par public:
\par   int f() const \{ return 2; \}
\par \};
\par 
\par int main() \{
\par   Derived d;
\par   Base* b1 = &d;
\par   Base& b2 = d;
\par   Base b3;
\par   // Late binding for both:
\par   cout << "b1->f() = " << b1->f() << endl;
\par   cout << "b2.f() = " << b2.f() << endl;
\par   // Early binding (probably):
\par   cout << "b3.f() = " << b3.f() << endl;
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
