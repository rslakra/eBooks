\par void h(Integer& c1, Integer& c2) \{
\par   // A complex expression:
\par   c1 += c1 * c2 + c2 % c1;
\par   #define TRY(OP) \\
\par   out << "c1 = "; c1.print(out); \\
\par   out << ", c2 = "; c2.print(out); \\
