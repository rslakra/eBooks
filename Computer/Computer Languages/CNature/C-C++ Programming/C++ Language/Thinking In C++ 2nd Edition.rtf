\rquote s an example that shows the movement through a file, but remember, you\rquote re not limited to seeking within files, as you are with C and }{\b cstdio}{. With C++, you can seek in any type of iostream (although the behavior of }{\b cin}{ & }{\b 
cout}{ when seeking is undefined):
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C18:Seeking.cpp
\par // Seeking in iostreams
\par #include "../require.h"
\par #include <iostream>
\par #include <fstream>
\par using namespace std;
\par 
\par int main(int argc, char* argv[]) \{
\par   requireArgs(argc, 1);
\par   ifstream in(argv[1]);
\par   assure(in, argv[1]); // File must already exist
\par   in.seekg(0, ios::end); // End of file
\par   streampos sp = in.tellg(); // Size of file
\par   cout << "file size = " << sp << endl;
\par   in.seekg(-sp/10, ios::end);
\par   streampos sp2 = in.tellg();
\par   in.seekg(0, ios::beg); // Start of file
\par   cout << in.rdbuf(); // Print whole file
\par   in.seekg(sp2); // Move to streampos
\par   // Prints the last 1/10th of the file:
\par   cout << endl << endl << in.rdbuf() << endl;
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {This program picks a file name off the command line and opens it as an }{\b ifstream}{. }{\b assert(\~) }{detects an open failure. Because this is a type of 
}{\b istream}{, }{\b seekg(\~)}{ is used to position the \ldblquote get pointer}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {get pointer}}}{.\rdblquote 
 The first call seeks zero bytes off the end of the file, that is, to the end. Because a }{\b streampos}{ is a }{\b typedef}{ for a }{\b long}{, calling }{\b tellg(\~)}{
 at that point also returns the size of the file, which is printed out. Then a seek is performed moving the get pointer 1/10 the size of the file \endash  notice it\rquote s a negative seek from the end of the file, so it backs up from the end.
 If you try to seek positively from the end of the file, the get pointer will just stay at the end. The }{\b streampos}{ at that point is captured into }{\b sp2}{, then a }{\b seekg(\~)}{
 is performed back to the beginning of the file so the whole thing can be printed out using the }{\b streambuf}{ pointer produced with }{\b rdbuf(\~)}{. Finally, the overloaded version of }{\b seekg(\~)}{ is used with the }{\b streampos}{ }{\b sp2}{
 to move to the previous position, and the last portion of the file is printed out.
\par }\pard\plain \s3\li360\sb120\sa60\sl-480\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel2\adjustright \f4\fs44\lang1024\cgrid {{\*\bkmkstart _Toc312373886}{\*\bkmkstart _Toc451776331}Creating read/write files
{\*\bkmkend _Toc312373886}{\*\bkmkend _Toc451776331}
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {Now that you know about the }{\b streambuf}{
 and how to seek, you can understand how to create a stream object that will both read and write a file. The following code first creates an }{\b ifstream}{ with flags that say it\rquote s both an input and an output file. The compiler won\rquote 
t let you write to an }{\b ifstream}{, however, so you need to create an }{\b ostream}{ with the underlying stream buffer:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {      ifstream in("filename", ios::in|ios::out);
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {      ostream out(in.rdbuf());
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {You may wonder what happens when you write to one of these objects. Here\rquote s an example:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C18:Iofile.cpp
\par // Reading & writing one file
\par #include "../require.h"
\par #include <iostream>
\par #include <fstream>
\par using namespace std;
\par 
\par int main() \{
\par   ifstream in("Iofile.cpp");
\par   assure(in, "Iofile.cpp");
\par   ofstream out("Iofile.out");
\par   assure(out, "Iofile.out");
\par   out << in.rdbuf(); // Copy file
\par   in.close();
\par   out.close();
\par   // Open for reading and writing:
\par   ifstream in2("Iofile.out", ios::in | ios::out);
\par   assure(in2, "Iofile.out");
\par   ostream out2(in2.rdbuf());
\par   cout << in2.rdbuf();  // Print whole file
\par   out2 << "Where does this end up?";
\par   out2.seekp(0, ios::beg);
\par   out2 << "And what about this?";
\par   in2.seekg(0, ios::beg);
\par   cout << in2.rdbuf();
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {\} ///:~
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The first five lines copy the source code for this program into a file called }{\b iofile.out}{, and th
en close the files. This gives us a safe text file to play around with. Then the aforementioned technique is used to create two objects that read and write to the same file. In }{\b cout << in2.rdbuf(\~)}{, you can see the \ldblquote get\rdblquote 
 pointer is initialized to the beginning of the file. The \ldblquote put\rdblquote  pointer, however, is set to the end of the file because \ldblquote Where does this end up?\rdblquote 
 appears appended to the file. However, if the put pointer is moved to the beginning with a }{\b seekp(\~)}{, all the inserted text }{\i overwrites }{the existing text. Both writes are seen when the get pointer is moved back to the beginning with a }{\b 
seekg(\~)}{, and the file is printed out. Of course, the file is automatically saved and closed when }{\b out2}{ goes out of scope and its destructor is called.
\par }\pard\plain \s2\fi-810\li720\sb120\sa120\sl-640\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel1\adjustright \f4\fs60\lang1024\cgrid {{\*\bkmkstart _Toc305628668}{\*\bkmkstart _Toc312373887}{\*\bkmkstart _Toc451776332
}stringstreams{\*\bkmkend _Toc451776332}
\par {\*\bkmkstart _Toc451776333}strstreams{\*\bkmkend _Toc305628668}{\*\bkmkend _Toc312373887}{\*\bkmkend _Toc451776333}
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {Before there were }{\b stringstream}{s, there were the more primitive }{\b strstream}{
s. Although these are not an official part of Standard C++, they have been around a long time so compilers will no doubt leave in the }{\b strstream}{ support in perpetuity, to compile legacy code. You should always use }{\b stringstream}{s, but it
\rquote s certainly likely that you\rquote ll come across code that uses }{\b strstream}{s and at that point this section should come in handy. In addition, this section should make it fairly clear why }{\b stringstream}{s have replace}{\b  strstream}{s.

\par }{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {strstream}}}{A }{\b strstream}{
 works directly with memory instead of a file or standard output. It allows you to use the same reading and formatting functions to manipulate bytes in memory. On old computers the memory was referred to as }{\i core}{
 so this type of functionality is often called }{\i in-core formatting}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {in-core formatting}}}{\pard\plain 
\sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {formatting\: in-core}}}{.
\par The class names for strstreams echo those for file streams. If you want to create a strstream to extract characters from, you create an }{\b istrstream}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid 
{\xe {istrstream}}}{. If you want to put characters into a strstream, you create an }{\b ostrstream}{\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {ostrstream}}}{.
\par String streams work with memory, so you must deal with the issue of where the memory comes from and where it goes. This isn\rquote t terribly 
complicated, but you must understand it and pay attention (it turned out is was too easy to lose track of this particular issue, thus the birth of }{\b stringstream}{s).
\par }\pard\plain \s3\li360\sb120\sa60\sl-480\slmult0\keep\keepn\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel2\adjustright \f4\fs44\lang1024\cgrid {{\*\bkmkstart _Toc312373888}{\*\bkmkstart _Toc451776334}User-allocated storage
{\*\bkmkend _Toc312373888}{\*\bkmkend _Toc451776334}
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {strstream\: user-allocated storage}}}{
The easiest approach to understand is when the user is responsible for allocating the storage. With }{\b istrstream}{s this is the only allowed approach. There are two constructors:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {istrstream::istrstream(char* buf);
\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {istrstream::istrstream(char* buf, int size);
\par }\pard\plain \s26\li360\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs6\lang1024\kerning18\cgrid {
\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {The first constructor takes a 
pointer to a zero-terminated character array; you can extract bytes until the zero. The second constructor additionally requires the size of the array, which doesn\rquote t have to be zero-terminated. You can extract bytes all the way to }{\b buf[size]}{
, whether or not you encounter a zero along the way.
\par When you hand an }{\b istrstream}{ constructor the address of an array, that array must already be filled with the characters you want to extract and presumably format into some other data type. Here\rquote s a simple example:}{\cs23\fs16\up6 \chftn 
