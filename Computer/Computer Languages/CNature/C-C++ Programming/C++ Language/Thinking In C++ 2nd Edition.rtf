\par }\pard\plain \s25\li360\sa60\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 \adjustright \f6\fs20\lang1024\kerning18\cgrid {(A = B++), C++, D++, E++;
\par }\pard\plain \s26\li360\widctlpar\adjustright \f6\fs6\lang1024\kerning18\cgrid {
