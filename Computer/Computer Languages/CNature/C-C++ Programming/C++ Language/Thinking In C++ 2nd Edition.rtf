\par // Non-inline template example
\par #include "../require.h"
\par 
\par template<class T>
\par class Array \{
\par   enum \{ size = 100 \};
\par   T A[size];
\par public:
\par   T& operator[](int index);
\par \};
\par 
\par template<class T>
\par T& Array<T>::operator[](int index) \{
\par   require(index >= 0 && index < size,
\par     "Index out of range");
\par   return A[index];
\par \}
