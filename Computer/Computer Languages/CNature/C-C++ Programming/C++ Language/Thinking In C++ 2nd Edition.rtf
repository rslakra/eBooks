\rquote s }{\b substr(\~)}{ member function to create a substring
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 \adjustright \f6\fs20\lang1024\kerning18\cgrid {//: C17:SmallString2.cpp
\par #include <string>
