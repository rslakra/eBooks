\par #include <iostream>
\par #include <strstream>
\par using namespace std;
\par 
\par int main() \{
\par   ostrstream s;
\par   s << "hi";
\par   char* old = s.str(); // Freezes s
\par   s.rdbuf()->freeze(0); // Unfreeze
\par   for(int i = 0; i < 100; i++)
