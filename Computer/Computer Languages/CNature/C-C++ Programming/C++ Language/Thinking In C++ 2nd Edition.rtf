\par }\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {\pard\plain \sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {re-throwing an exception}}}{\pard\plain 
\sa120\widctlpar{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \v\fs20\cgrid {\xe {exception handling\: re-throwing an exception}}}{Sometimes you\rquote ll want to rethrow the exception that you just caught, particularly when you u
se the ellipses to catch any exception because there\rquote s no information available about the exception. This is accomplished by saying }{\b throw}{ with no argument:
\par }\pard\plain \s24\li360\sl240\slmult0\widctlpar\brdrl\brdrs\brdrw15\brsp200 {\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \f6\fs20\lang1024\kerning18\cgrid {catch(...) \{
\par   cout << "an exception was thrown" << endl;
\par   throw;
