\par using namespace std;
\par 
\par class Shape \{
\par protected:
\par   static int count;
\par public:
\par   Shape() \{ count++; \}
\par   virtual ~Shape() \{ count--; \}
\par   virtual void draw() const = 0;
\par   static int quantity() \{ return count; \}
\par \};
\par 
\par int Shape::count = 0;
\par 
\par class SRectangle : public Shape \{
\par   void operator=(SRectangle&); // Disallow
\par protected:
\par   static int count;
\par public:
\par   SRectangle() \{ count++; \}
\par   SRectangle(const SRectangle&) \{ count++;\}
\par   ~SRectangle() \{ count--; \}
\par   void draw() const \{
\par     cout << "SRectangle::draw()" << endl;
\par   \}
\par   static int quantity() \{ return count; \}
\par \};
\par 
\par int SRectangle::count = 0;
\par 
\par class SEllipse : public Shape \{
\par   void operator=(SEllipse&); // Disallow
\par protected:
\par   static int count;
\par public:
\par   SEllipse() \{ count++; \}
\par   SEllipse(const SEllipse&) \{ count++; \}
\par   ~SEllipse() \{ count--; \}
\par   void draw() const \{
\par     cout << "SEllipse::draw()" << endl;
\par   \}
\par   static int quantity() \{ return count; \}
\par \};
\par 
\par int SEllipse::count = 0;
\par 
\par class SCircle : public SEllipse \{
