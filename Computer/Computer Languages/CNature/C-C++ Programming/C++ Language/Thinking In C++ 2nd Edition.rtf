\par   SCircle() \{ count++; \}
\par   SCircle(const SCircle&) \{ count++; \}
\par   ~SCircle() \{ count--; \}
\par   void draw() const \{
\par     cout << "SCircle::draw()" << endl;
\par   \}
\par   static int quantity() \{ return count; \}
\par \};
\par 
\par int SCircle::count = 0;
\par 
\par int main() \{
\par   vector<Shape*> shapes;
\par   srand(time(0)); // Seed random number generator
\par   const int mod = 12;
\par   // Create a random quantity of each type:
\par   for(int i = 0; i < rand() % mod; i++)
\par     shapes.push_back(new SRectangle);
\par   for(int j = 0; j < rand() % mod; j++)
\par     shapes.push_back(new SEllipse);
\par   for(int k = 0; k < rand() % mod; k++)
\par     shapes.push_back(new SCircle);
\par   int nCircles = 0;
\par   int nEllipses = 0;
\par   int nRects = 0;
\par   int nShapes = 0;
\par   for(int u = 0; u < shapes.size(); u++) \{
\par     shapes[u]->draw();
\par     if(dynamic_cast<SCircle*>(shapes[u]))
\par       nCircles++;
\par     if(dynamic_cast<SEllipse*>(shapes[u]))
\par       nEllipses++;
\par     if(dynamic_cast<SRectangle*>(shapes[u]))
\par       nRects++;
\par     if(dynamic_cast<Shape*>(shapes[u]))
\par       nShapes++;
\par   \}
\par   cout << endl << endl
\par     << "Circles = " << nCircles << endl
\par     << "Ellipses = " << nEllipses << endl
\par     << "Rectangles = " << nRects << endl
