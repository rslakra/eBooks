\par 
\par class Obj \{
\par   int i, j, k;
\par   enum \{ sz = 100 \};
\par   char buf[sz];
\par public:
\par   void initialize() \{ // Can't use constructor
\par     cout << "initializing Obj" << endl;
\par     i = j = k = 0;
\par     memset(buf, 0, sz);
\par   \}
\par   void destroy() \{ // Can't use destructor
\par     cout << "destroying Obj" << endl;
\par   \}
\par \};
\par 
\par int main() \{
\par   Obj* obj = (Obj*)malloc(sizeof(Obj));
\par   require(obj != 0);
\par   obj->initialize();
\par   // ... sometime later:
