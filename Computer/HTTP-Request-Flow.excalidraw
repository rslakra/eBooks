      "boundElements": null,
      "updated": 1715046875018,
      "link": null,
      "locked": false,
      "text": "And Controller classes are also annotated with either @Controller or @RestController annotations.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "And Controller classes are also annotated with either @Controller or @RestController annotations.",
      "lineHeight": 1.25
    },
    {
      "id": "b5QDEtMiOrUXwFsFRUQgm",
      "type": "text",
      "x": 360.34674072265625,
      "y": 616.1964416503906,
      "width": 894.9791870117188,
      "height": 50,
      "angle": 0,
