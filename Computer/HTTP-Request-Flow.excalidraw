    {
      "id": "vOCRr41XlLOFHT67kwIJo",
      "type": "text",
      "x": 1128.4857177734375,
      "y": 239.05844116210938,
      "width": 907.5771327611758,
      "height": 318.33660888671875,
      "angle": 0,
