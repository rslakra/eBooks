	/**
	 * (non-Javadoc)
	 * 
	 * @param reason
	 * @param lastVxml
	 * @see com.ehit.junit.apptReminder.ApptReminderTestCase#testDoPost(java.lang.String,
	 *      java.lang.String)
	 */
	public void testDoPost(String reason, String lastVxml) {
		try {
			/* initialized each reference. */
			super.reInitThis();

			/* request and session testing. */
			setDefaultRequestAndSessionValues();
			if (null != reason) {
				setHttpRequestParams(Constants.KEY_REASON, reason);
			}
			if (null != lastVxml) {
				setHttpRequestParams(Constants.KEY_LAST_VXML, lastVxml);
			}

			ApptReminderServlet.queryLookUpApptInfo = QUERY_LOOKUP_APPT_INFO;
			ApptReminderServlet.queryEndCallReporting = QUERY_END_CALL;
			ApptReminderServlet apptReminderServlet = new ApptReminderServlet();
			/*
			 * Loads the 'WEB-INF/Wordings.properties' file from the specified
			 * path.
			 */
			Properties tTSWordings = getUtils().loadProperties(
					System.getProperty("user.dir")
							+ "/WebContent/WEB-INF/Wordings.properties");
			getRenderVxml().setTTSWordings(tTSWordings);

			/* fetch database record. */
			Appointment appt = getAppointment(true);
			setHttpRequestOrSessionAttribute(Constants.KEY_APPT_INFO, appt,
					true);

			getRenderVxml().setIpPortAppNameAndXmlLang(
					getHttpServletRequest().getSession());
			getRenderVxml().setAppt(appt);

			Utils.print(getHttpServletRequest());
			/* set response's content type and initialize session and out. */
			HttpSession session = getHttpServletRequest().getSession();

			/* local variables. */
			String endCallQuery = null;

			/*
			 * update ani, transferDnis, dialogicOutcome, callAnswered and
			 * userLangCode variables with session values.
			 */
			String ani = getUtils().getAttribute(session, Constants.KEY_ANI,
					Constants.ZERO);
			String dialogicOutcome = getUtils().getAttribute(session,
					Constants.KEY_DIALOGIC_OUTCOME, Constants.CONNECTED);
			boolean callAnswered = Constants.CONNECTED.equals(dialogicOutcome);
			String recipientLanguage = getUtils().getAttribute(session,
					Constants.KEY_XML_LANG);

			/* Get session's appointment details. */
			appt = getUtils().getAppointment(session);
			getRenderVxml().setAppt(appt);
			System.out.println("In doPost, reason:" + reason + ", lastVxml:"
					+ lastVxml + ", ani:" + ani + ", dialogicOutcome:"
					+ dialogicOutcome + ", callAnswered:" + callAnswered
					+ ", recipientLanguage: " + recipientLanguage + ", appt: "
					+ appt);
			/* #1 - reason == root (ar1012_PlayWelcome_PP) */
			if (Constants.ROOT.equals(reason)) {
				getRenderVxml().playWelcome(getHttpServletRequest(),
						getVXmlOut(), callAnswered, lastVxml);
				/* language offered and user chose. */
			} else if (XmlTags.XML_LANG_EN_US.equals(reason)
					|| Constants.XML_LANG_ES_MX.equals(reason)) {
				/* Update session with new language. */
				session.setAttribute(Constants.KEY_XML_LANG, reason);
				getRenderVxml().setRoot(getVXmlOut(), session, Constants.ROOT,
						Constants.NONE);
			} else if (Constants.ERROR.equals(reason)) { /* #2 - reason = error */
				getRenderVxml().noDataError(getHttpServletRequest(),
						getVXmlOut());
			} else if (Constants.HANGUP.equals(reason)) {/* #3 - reason = hangup */
				/* Initialize database connect with data source connection. */
				initConnection();
				/* If reason = hangup, End Call Reporting. */
				endCallQuery = apptReminderServlet.makeEndCallQuery(ani,
						Constants.ONE, lastVxml, reason,
						appt.getTransferDNIS(), recipientLanguage);
				apptReminderServlet.endCallReporting(getDBUtils(), getUtils(),
						getHttpServletRequest(), getXmlUtil(), getVXmlOut(),
						getRenderVxml(), endCallQuery, null);
				/* close connection and release resources. */
				closeConnection();
			} else if (Constants.GOOD_BYE.equals(reason)) {
				/* Initialize database connect with data source connection. */
				initConnection();
				/* If reason = goodbye, End Call Reporting. */
				endCallQuery = apptReminderServlet.makeEndCallQuery(ani,
						Constants.ZERO, lastVxml, reason,
						appt.getTransferDNIS(), recipientLanguage);
				apptReminderServlet.endCallReporting(getDBUtils(), getUtils(),
						getHttpServletRequest(), getXmlUtil(), getVXmlOut(),
						getRenderVxml(), endCallQuery, appt);
				/* close connection and release resources. */
				closeConnection();
				/*
				 * #5 - if (reason = (maxnomatch||maxnoinput) and lasxtVxml =
				 * offerRepeatDirections)
				 */
			} else if ((Constants.MAX_NO_MATCH.equals(reason) || Constants.MAX_NO_INPUT
					.equals(reason))
					&& Constants.OFFER_REPEAT_DIRECTIONS.equals(lastVxml)) {
				/* Initialize database connect with data source connection. */
				initConnection();
				/**
				 * If reason = (maxnomatch||maxnoinput) and lasxtVxml =
				 * offerRepeatDirections, End Call Reporting.
				 */
				endCallQuery = apptReminderServlet.makeEndCallQuery(ani,
						Constants.ZERO, lastVxml, reason,
						appt.getTransferDNIS(), recipientLanguage);
				apptReminderServlet.endCallReporting(getDBUtils(), getUtils(),
						getHttpServletRequest(), getXmlUtil(), getVXmlOut(),
						getRenderVxml(), endCallQuery, appt);
				/* close connection and release resources. */
				closeConnection();
				/*
				 * #6 - if (reason = (maxnomatch || maxnoinput || yes) and
				 * lastVxml = askIfCanKeepAppointment) or reason =
				 * playApptRepeat and lastVxml = offerRepeatAdditional or reason
				 * in (maxnomatch||maxnoinput||MACHINE).
				 */
			} else if ((Constants.YES.equals(reason) && Constants.ASK_IF_CAN_KEEP_APPOINTMENT
					.equals(lastVxml))
					|| Constants.MAX_NO_MATCH.equals(reason)
					|| Constants.MAX_NO_INPUT.equals(reason)
					|| Constants.MACHINE.equals(reason)
					|| (Constants.PLAY_APPT_REPEAT.equals(reason) && Constants.OFFER_REPEAT_ADDITIONAL
							.equals(lastVxml))) {
				/* set header 2. */
				getRenderVxml().setHeader2(getHttpServletRequest(),
						getVXmlOut());
				getRenderVxml().playAdditionalInformation(getVXmlOut(),
						callAnswered, reason);
				getRenderVxml().setFooter(getVXmlOut());
				/*
				 * #7 - The call not answered and (reason = hangupAnsMach or
				 * goodbye)
				 */
			} else if (!callAnswered
					&& Constants.HANGUP_ANS_MACH.equals(reason)) {
				/* Initialize database connect with data source connection. */
				initConnection();
				/* end call reporting. */
				endCallQuery = apptReminderServlet.makeEndCallQuery(ani,
						Constants.ONE_THOUSAND_ONE, lastVxml, reason,
						appt.getTransferDNIS(), recipientLanguage);
				apptReminderServlet.endCallReporting(getDBUtils(), getUtils(),
						getHttpServletRequest(), getXmlUtil(), getVXmlOut(),
						getRenderVxml(), endCallQuery, appt);
				/* close connection and release resources. */
				closeConnection();
				/*
				 * #8 - reason = playDirections and lastVxml =
				 * (playAdditionalApptInfo or offerRepeatDirections)
				 */
			} else if (Constants.PLAY_DIRECTIONS.equals(reason)
					&& (Constants.PLAY_ADDITIONAL_INFORMATION.equals(lastVxml) || Constants.OFFER_REPEAT_DIRECTIONS
							.equals(lastVxml))) {
				getRenderVxml().setHeader2(getHttpServletRequest(),
						getVXmlOut());
				/* Optimized - based on facility address TTT/Key. */
				if (appt.isFacilityAddress()) {
					getRenderVxml().offerDirections(getVXmlOut());
				} else {
					getRenderVxml().offerRepeatAdditional(getVXmlOut());
				}
				getRenderVxml().setFooter(getVXmlOut());
				/*
				 * #9 - if (reason = offerDirections) OR (reason = yes and
				 * lastVxml = offerDirections)
				 */
			} else if (Constants.OFFER_DIRECTIONS.equals(reason)
					|| (Constants.YES.equals(reason) && Constants.OFFER_DIRECTIONS
							.equals(lastVxml))) {
				getRenderVxml().setHeader3(getHttpServletRequest(),
						getVXmlOut());
				getRenderVxml().playDirections(getVXmlOut());
				getRenderVxml().setFooter(getVXmlOut());
				/*
				 * #10 - reason = offerRepeatDirections and lastVxml =
				 * playDirections
				 */
			} else if (Constants.OFFER_REPEAT_DIRECTIONS.equals(reason)
					&& Constants.PLAY_DIRECTIONS.equals(lastVxml)) {
				getRenderVxml().setHeader3(getHttpServletRequest(),
						getVXmlOut());
				getRenderVxml().offerRepeatDirections(getVXmlOut());
				getRenderVxml().setFooter(getVXmlOut());
				/*
				 * #11 - reason = no and lastVxml = askIfCanKeepAppointment
				 */
			} else if (Constants.NO.equals(reason)
					&& Constants.ASK_IF_CAN_KEEP_APPOINTMENT.equals(lastVxml)) {
				getRenderVxml().setHeader3(getHttpServletRequest(),
						getVXmlOut());
				getRenderVxml().askCancelReschedule(getVXmlOut());
				getRenderVxml().setFooter(getVXmlOut());
				/*
				 * #12 - reason = cancel and (lastVxml = askCancelReschedule or
				 * lastVxml = askIfCanKeepAppointment)
				 */
			} else if (Constants.CANCEL.equals(reason)) {
				if (Constants.ASK_CANCEL_RESCHEDULE.equals(lastVxml)
						|| Constants.ASK_IF_CAN_KEEP_APPOINTMENT
								.equals(lastVxml)) {
					getRenderVxml().setHeader3(getHttpServletRequest(),
							getVXmlOut());
					getRenderVxml().confirmCancel(getVXmlOut());
					getRenderVxml().setFooter(getVXmlOut());
				} else if (Constants.CONFIRM_CANCEL.equals(lastVxml)) {
					/* Initialize database connect with data source connection. */
					initConnection();
					/* xfer with endCallQuery */
					endCallQuery = apptReminderServlet.makeEndCallQuery(ani,
							Constants.ONE_THOUSAND_THREE, lastVxml, reason,
							appt.getTransferDNIS(), recipientLanguage);
					apptReminderServlet.callXfer(getDBUtils(), getUtils(),
							getHttpServletRequest(), getXmlUtil(),
							getVXmlOut(), getRenderVxml(), endCallQuery);
					/* close connection and release resources. */
					closeConnection();
				}
				/*
				 * #13 - reason = reschedule and (lastVxml = askCancelReschedule
				 * or lastVxml = askIfCanKeepAppointment)
				 */
			} else if (Constants.RESCHEDULE.equals(reason)) {
				/* lastVxml = (askIfCanKeepAppointment or askCancelReschedule) */
				if (Constants.ASK_CANCEL_RESCHEDULE.equals(lastVxml)
						|| Constants.ASK_IF_CAN_KEEP_APPOINTMENT
								.equals(lastVxml)) {
					getRenderVxml().setHeader3(getHttpServletRequest(),
							getVXmlOut());
					getRenderVxml().confirmReschedule(getVXmlOut());
					getRenderVxml().setFooter(getVXmlOut());
					/* lastVxml = confirmReschedule */
				} else if (Constants.CONFIRM_RESCHEDULE.equals(lastVxml)) {
					/* Initialize database connect with data source connection. */
					initConnection();
					/* xfer with endCallQuery */
					endCallQuery = apptReminderServlet.makeEndCallQuery(ani,
							Constants.ONE_THOUSAND_FOUR, lastVxml, reason,
							appt.getTransferDNIS(), recipientLanguage);
					apptReminderServlet.callXfer(getDBUtils(), getUtils(),
							getHttpServletRequest(), getXmlUtil(),
							getVXmlOut(), getRenderVxml(), endCallQuery);
					/* close connection and release resources. */
					closeConnection();
				}
				/*
				 * All (reason = repeat) cases handle here.
				 * 
				 * # - reason = repeat and lastVxml = (askIfCanKeepAppointment
				 * or askCancelReschedule) the playWelcome, OR
				 * 
				 * # - reason = repeat and lastVxml = offerRepeatDirections then
				 * play directions, OR
				 * 
				 * # - reason = repeat and lastVxml = offerDirections then play
				 * additional information.
				 */
			} else if (Constants.REPEAT.equals(reason)) {
				/* lastVxml = askIfCanKeepAppointment OR askCancelReschedule */
				if (Constants.ASK_IF_CAN_KEEP_APPOINTMENT.equals(lastVxml)
						|| Constants.ASK_CANCEL_RESCHEDULE.equals(lastVxml)) {
					getRenderVxml().playWelcome(getHttpServletRequest(),
							getVXmlOut(), callAnswered, lastVxml);
					/* lastVxml = offerRepeatDirections */
				} else if (Constants.OFFER_REPEAT_DIRECTIONS.equals(lastVxml)) {
					getRenderVxml().setHeader3(getHttpServletRequest(),
							getVXmlOut());
					getRenderVxml().playDirections(getVXmlOut());
					getRenderVxml().setFooter(getVXmlOut());
					/* lastVxml = offerDirections */
				} else if (Constants.OFFER_DIRECTIONS.equals(lastVxml)) {
					getRenderVxml().setHeader2(getHttpServletRequest(),
							getVXmlOut());
					getRenderVxml().playAdditionalInformation(getVXmlOut(),
							callAnswered, reason);
					getRenderVxml().setFooter(getVXmlOut());
					/* lastVxml = askCancelReschedule */
				}
			} else if (Constants.GO_BACK.equals(reason)) {/* #19 - reason = goback */
				getRenderVxml().playWelcome(getHttpServletRequest(),
						getVXmlOut(), callAnswered, lastVxml);
			} else if (Constants.TRANSFER.equals(reason)) {
				/* Initialize database connect with data source connection. */
				initConnection();
				/* Optimized and commented unused code above. */
				endCallQuery = apptReminderServlet.makeEndCallQuery(ani,
						Constants.ONE_THOUSAND_TWO, lastVxml, reason,
						appt.getTransferDNIS(), recipientLanguage);
				apptReminderServlet.callXfer(getDBUtils(), getUtils(),
						getHttpServletRequest(), getXmlUtil(), getVXmlOut(),
						getRenderVxml(), endCallQuery);
				/* close connection and release resources. */
				closeConnection();
			} else if (Constants.HELP.equals(reason)) {/* #22 - reason = help */
				if (Constants.ASK_CANCEL_RESCHEDULE.equals(lastVxml)) {
					/* Initialize database connect with data source connection. */
					initConnection();
					/* xfer with endCallQuery */
					endCallQuery = apptReminderServlet.makeEndCallQuery(ani,
							Constants.ONE_THOUSAND_TWO, lastVxml, reason,
							appt.getTransferDNIS(), recipientLanguage);
					apptReminderServlet.callXfer(getDBUtils(), getUtils(),
							getHttpServletRequest(), getXmlUtil(),
							getVXmlOut(), getRenderVxml(), endCallQuery);
					/* close connection and release resources. */
					closeConnection();
				} else {
					/* transfer call to agent. */
					getRenderVxml().setHeader2(getHttpServletRequest(),
							getVXmlOut());
					getRenderVxml().askAgent(getVXmlOut());
					getRenderVxml().setFooter(getVXmlOut());
				}
			} else {/* #24 - no condition matches. */
				/* Initialize database connect with data source connection. */
				initConnection();
				endCallQuery = apptReminderServlet.makeEndCallQuery(ani,
						Constants.ONE_THOUSAND_TWO, lastVxml, reason,
						appt.getTransferDNIS(), recipientLanguage);
				apptReminderServlet.callXfer(getDBUtils(), getUtils(),
						getHttpServletRequest(), getXmlUtil(), getVXmlOut(),
						getRenderVxml(), endCallQuery);
				/* close connection and release resources. */
				closeConnection();
			}

			/* write generated VXML into file and print at console. */
			makeXmlFile("DoPost" + validFileName(reason)
					+ validFileName(lastVxml));

			/* release resources. */
			releaseResources();
		} catch (ServletException ex) {
			ex.printStackTrace();

		} catch (IOException ioe) {
			ioe.printStackTrace();
		}
	}

