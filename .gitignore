### Python — tooling: pdm, PEP 582, pybuilder ###
#   pdm.lock, Pipfile.lock and poetry.lock are usually committed, so they aren't ignored here.
#   .python-version: commit it for an application, ignore it for a library.
.pdm-build/
.pdm-python
.pdm.toml
.pybuilder/
__pypackages__/

